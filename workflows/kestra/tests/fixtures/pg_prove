#!/usr/bin/env bash

set -euo pipefail

if [ "${1:-}" = "--version" ]; then
  echo "pg_prove 3.36"
  exit 0
fi

[ "${VORTEX_TEST_FAIL_PG_PROVE:-false}" != "true" ] || exit 41

[ "${PGPASSWORD:-}" = 'placeholder:=/%?&password' ]
[ "${PGSSLMODE:-}" = "verify-full" ]
[ -n "${PGSSLROOTCERT:-}" ]
test -s "$PGSSLROOTCERT"
[[ " $* " = *" --dbname postgres "* ]]
[[ " $* " = *" --username postgres.abcdefghijklmnopqrst "* ]]
[[ " $* " = *" --host aws-0-ap-southeast-2.pooler.supabase.com "* ]]
[[ " $* " = *" --port 5432 "* ]]
sql_suite="${!#}"
[[ "$sql_suite" =~ ^supabase/tests/[A-Za-z0-9_.-]+[.]sql$ ]]

if [ -n "${VORTEX_TEST_PG_PROVE_MARKER:-}" ]; then
  printf '%s\n' "$sql_suite" >>"$VORTEX_TEST_PG_PROVE_MARKER"
fi
