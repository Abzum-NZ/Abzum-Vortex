#!/usr/bin/env bash

set -euo pipefail

[ "${PGPASSWORD:-}" = 'placeholder:=/%?&password' ]
[ "$1" = "$VORTEX_TEST_EXPECTED_DATABASE_URL" ]

case "$*" in
  *server_version_num*) printf '%s\n' "${VORTEX_TEST_SERVER_VERSION_NUM:-170000}" ;;
  *database-state-snapshot.sql*)
    snapshot_call=1
    if [ -n "${VORTEX_TEST_DATABASE_STATE_SNAPSHOT_COUNTER:-}" ]; then
      if [ -f "$VORTEX_TEST_DATABASE_STATE_SNAPSHOT_COUNTER" ]; then
        snapshot_call="$(( $(<"$VORTEX_TEST_DATABASE_STATE_SNAPSHOT_COUNTER") + 1 ))"
      fi
      printf '%s\n' "$snapshot_call" >"$VORTEX_TEST_DATABASE_STATE_SNAPSHOT_COUNTER"
    fi
    if [ "$snapshot_call" -gt 1 ] && [ -n "${VORTEX_TEST_POST_DATABASE_STATE_SNAPSHOT:-}" ]; then
      printf '%s\n' "$VORTEX_TEST_POST_DATABASE_STATE_SNAPSHOT"
    else
      printf '%s\n' "${VORTEX_TEST_DATABASE_STATE_SNAPSHOT:-snapshot-v1}"
    fi
    ;;
  *to_regclass*)
    if [ "${VORTEX_TEST_EMPTY_HISTORY:-false}" = "true" ]; then printf 'f\n'; else printf 't\n'; fi
    ;;
  *supabase_migrations.schema_migrations*)
    if [ -n "${VORTEX_TEST_INITIAL_HISTORY:-}" ] &&
      ! grep --quiet '^db push ' "${VORTEX_TEST_SUPABASE_CALL_MARKER:-/dev/null}" 2>/dev/null; then
      cat "$VORTEX_TEST_INITIAL_HISTORY"
    elif [ "${VORTEX_TEST_REMOTE_MIGRATION_MISMATCH:-false}" = "true" ] ||
      { [ "${VORTEX_TEST_POST_APPLY_MISMATCH:-false}" = "true" ] &&
        grep --quiet '^db push ' "${VORTEX_TEST_SUPABASE_CALL_MARKER:-/dev/null}" 2>/dev/null; }; then
      printf '20000101000000_unreviewed.sql\n'
    else
      git -C "${VORTEX_TEST_SOURCE_REPOSITORY:-/source}" \
        ls-tree -r --name-only "$VORTEX_GITHUB_COMMIT" -- supabase/migrations |
        LC_ALL=C sort |
        sed 's#^supabase/migrations/##'
    fi
    ;;
  *) echo "unexpected psql invocation" >&2; exit 1 ;;
esac
