{
  "name": "@vortex/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@vortex/web",
    "auth:local:prepare": "node tooling/supabase/ensure-local-signing-key.mjs",
    "db:start": "pnpm auth:local:prepare && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "pnpm auth:local:prepare && supabase db reset",
    "db:new": "pnpm auth:local:prepare && supabase migration new",
    "setup:local": "pnpm --filter @vortex/web setup:local",
    "demo:setup": "pnpm --filter @vortex/web demo:setup",
    "demo:owner": "pnpm --filter @vortex/web demo:owner",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "guard": "node tooling/guard/guard.ts",
    "knip": "knip",
    "build": "turbo run build",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "eslint": "catalog:",
    "knip": "catalog:",
    "prettier": "catalog:",
    "supabase": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
