{
  "name": "@vortex/workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@vortex/web",
    "auth:local:prepare": "node tooling/supabase/ensure-local-signing-key.mjs",
    "db:start": "pnpm auth:local:prepare && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "pnpm auth:local:prepare && supabase db reset",
    "db:new": "pnpm auth:local:prepare && supabase migration new",
    "db:clean": "node tooling/supabase/run-local-database-clean.mjs",
    "setup:local": "pnpm --filter @vortex/web setup:local",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build",
    "catalogue:fingerprints": "node tooling/generate-catalogue-fingerprints.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "next": "16.3.5",
    "postgres": "catalog:",
    "prettier": "3.9.8",
    "supabase": "catalog:",
    "turbo": "2.11.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
