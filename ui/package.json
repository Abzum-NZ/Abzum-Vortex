{
  "name": "@vortex/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./styles/*.css": "./src/styles/*.css"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@vortex/contracts": "workspace:*",
    "@vortex/rule": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "catalog:",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-day-picker": "catalog:",
    "shadcn": "4.21.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "catalog:",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "vortex": {
    "tier": 10,
    "environment": "browser",
    "ships": true
  }
}
