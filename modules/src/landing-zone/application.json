      {
        "contractVersion": "1.0.0",
        "id": "landing_zone_save_favourite_status",
        "key": "landing_zone_save_favourite_status",
        "description": "Saves only the submitted favourite status for the protected tile subject, then returns to saved tile management.",
        "labels": { "name": "Save favourite" },
        "execution": "interactive",
        "runAs": { "kind": "initiator" },
        "inputs": {
          "record": { "type": "record_reference", "required": true, "recordTypeIds": ["vortex.landing_zone:tile"] },
          "is_favourite": { "type": "yes_no", "required": true }
        },
        "variables": {},
        "tasks": [
          {
            "id": "save_favourite_status",
            "type": "record.save",
            "version": "1.0.0",
            "properties": {
              "record_type": { "kind": "literal", "literal": { "type": "text", "value": "vortex.landing_zone:tile" } },
              "record": { "kind": "reference", "reference": { "source": "input", "name": "record" } },
              "values": {
                "kind": "map",
                "entries": {
                  "is_favourite": { "kind": "reference", "reference": { "source": "input", "name": "is_favourite" } }
                }
              }
            }
          },
          {
            "id": "return_to_manage_saved_tiles",
            "type": "interface.navigate",
            "version": "1.0.0",
            "properties": {
              "page": { "kind": "literal", "literal": { "type": "text", "value": "page_landing_manage_saved_tiles" } }
            }
          }
        ],
        "outputs": {
          "record": {
            "type": "record_reference",
            "recordTypeIds": ["vortex.landing_zone:tile"],
            "value": { "kind": "reference", "reference": { "source": "task_output", "task": "save_favourite_status", "key": "record" } }
          }
        }
      }
    ],
    "flow_bindings": [
