      {
        "contractVersion": "1.0.0",
        "id": "landing_zone_bookmark_create",
        "key": "landing_zone_bookmark_create",
        "description": "Creates a bookmark tile from the submitted values and opens the Bookmarks page.",
        "labels": { "name": "Add bookmark" },
        "execution": "interactive",
        "runAs": { "kind": "initiator" },
        "inputs": {
          "target_kind": { "type": "choice", "required": true },
          "application_key": { "type": "text", "required": false },
          "page_key": { "type": "text", "required": false },
          "record_type": { "type": "text", "required": false },
          "record_id": { "type": "text", "required": false },
          "external_address": { "type": "text", "required": false },
          "label": { "type": "text", "required": false },
          "description": { "type": "text", "required": false }
        },
        "variables": {
          "bookmark_values": { "type": "json", "default": {} }
        },
        "tasks": [
          {
            "id": "prepare_values",
            "type": "data.set_variable",
            "version": "1.0.0",
            "properties": {
              "variable": {
                "kind": "literal",
                "literal": { "type": "text", "value": "bookmark_values" }
              },
              "value": {
                "kind": "map",
                "entries": {
                  "target_kind": {
                    "kind": "reference",
                    "reference": { "source": "input", "name": "target_kind" }
                  },
                  "application_key": {
                    "kind": "reference",
                    "reference": { "source": "input", "name": "application_key" }
                  },
                  "page_key": {
                    "kind": "reference",
                    "reference": { "source": "input", "name": "page_key" }
                  },
                  "record_type": {
                    "kind": "reference",
                    "reference": { "source": "input", "name": "record_type" }
                  },
                  "record_id": {
                    "kind": "formula",
                    "formula": {
                      "op": "if",
                      "condition": {
                        "op": "is_empty",
                        "arg": {
                          "op": "reference",
                          "reference": { "source": "input", "name": "record_id" }
                        }
                      },
                      "then": { "op": "literal", "type": "json", "value": null },
                      "else": {
                        "op": "reference",
                        "reference": { "source": "input", "name": "record_id" }
                      }
                    }
                  },
                  "external_address": {
                    "kind": "formula",
                    "formula": {
                      "op": "if",
                      "condition": {
                        "op": "is_empty",
                        "arg": {
                          "op": "reference",
                          "reference": { "source": "input", "name": "external_address" }
                        }
                      },
                      "then": { "op": "literal", "type": "json", "value": null },
                      "else": {
                        "op": "reference",
                        "reference": { "source": "input", "name": "external_address" }
                      }
                    }
                  },
                  "label": {
                    "kind": "reference",
                    "reference": { "source": "input", "name": "label" }
                  },
                  "description": {
                    "kind": "reference",
                    "reference": { "source": "input", "name": "description" }
                  }
                }
              }
            }
          },
          {
            "id": "save",
            "type": "record.save",
            "version": "1.0.0",
            "properties": {
              "record_type": {
                "kind": "literal",
                "literal": { "type": "text", "value": "vortex.landing_zone:tile" }
              },
              "values": {
                "kind": "reference",
                "reference": { "source": "variable", "name": "bookmark_values" }
              }
            }
          },
          {
            "id": "open_bookmarks",
            "type": "interface.navigate",
            "version": "1.0.0",
            "properties": {
              "page": {
                "kind": "literal",
                "literal": { "type": "text", "value": "page_landing_bookmarks" }
              }
            }
          }
        ],
        "outputs": {
          "record": {
            "type": "record_reference",
            "recordTypeIds": ["vortex.landing_zone:tile"],
            "value": {
              "kind": "reference",
              "reference": { "source": "task_output", "task": "save", "key": "record" }
            }
          }
        }
      },
      {
        "contractVersion": "1.0.0",
        "id": "landing_zone_open_favourite_status",
        "key": "landing_zone_open_favourite_status",
        "description": "Opens the protected Favourite status form for one returned tile record.",
        "labels": { "name": "Edit favourite" },
