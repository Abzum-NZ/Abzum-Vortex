    "queries": [
      {
        "id": "qry_crm_pipeline",
        "key": "crm_pipeline",
        "record_type": "vortex.crm.opportunities:opportunity",
        "select": [
          "opportunity_number",
          "name",
          "company",
          "value",
          "net_value",
          "stage",
          "expected_close_date"
        ],
        "filter": {
          "field": "stage",
          "operator": "not_in",
          "value": [
            "won",
            "lost"
          ]
        },
        "sort": [
          {
            "field": "expected_close_date",
            "direction": "ascending"
          }
        ],
        "group_by": [],
        "aggregates": [],
        "page_size": 50,
        "relationship_hops": 0
      },
      {
        "id": "qry_crm_companies",
        "key": "crm_companies",
        "record_type": "vortex.crm.organisations:company",
        "select": [
          "company_number",
          "name",
          "industry",
          "phone",
          "website"
        ],
        "filter": null,
        "sort": [
          {
            "field": "name",
            "direction": "ascending"
          }
        ],
        "group_by": [],
        "aggregates": [],
        "page_size": 50,
        "relationship_hops": 0
      },
      {
        "id": "qry_crm_contacts",
        "key": "crm_contacts",
        "record_type": "vortex.crm.people:contact",
        "select": [
          "contact_number",
          "full_name",
          "email",
          "company",
          "relationship_owner"
        ],
        "filter": null,
        "sort": [
          {
            "field": "full_name",
            "direction": "ascending"
          }
        ],
        "group_by": [],
        "aggregates": [],
        "page_size": 50,
        "relationship_hops": 0
      },
      {
        "id": "qry_crm_leads",
        "key": "crm_leads",
        "record_type": "vortex.crm.people:lead",
        "select": [
          "lead_number",
          "display_name",
          "company_name",
          "source",
          "score",
          "status",
          "received_at"
        ],
        "filter": {
          "field": "status",
          "operator": "not_equals",
          "value": "converted"
        },
        "sort": [
          {
            "field": "received_at",
            "direction": "descending"
          }
        ],
        "group_by": [],
        "aggregates": [],
        "page_size": 50,
        "relationship_hops": 0
      },
      {
        "id": "qry_crm_activities",
        "key": "crm_activities",
        "record_type": "vortex.crm.activities:activity",
        "select": [
          "subject",
          "activity_type",
          "due_at",
          "completed",
          "regarding",
          "owner"
        ],
        "filter": {
          "field": "completed",
          "operator": "equals",
          "value": false
        },
        "sort": [
          {
            "field": "due_at",
            "direction": "ascending"
          }
        ],
        "group_by": [],
        "aggregates": [],
        "page_size": 50,
        "relationship_hops": 0
      },
      {
        "id": "qry_crm_shared_cases",
        "key": "crm_shared_cases",
        "record_type": "vortex.service_desk.cases:case",
        "select": [
          "case_number",
          "subject",
          "status",
          "priority",
          "customer_company",
          "resolved_at"
        ],
        "filter": null,
        "sort": [
          {
            "field": "case_number",
            "direction": "descending"
          }
        ],
        "group_by": [],
        "aggregates": [],
        "page_size": 50,
        "relationship_hops": 0
      }
