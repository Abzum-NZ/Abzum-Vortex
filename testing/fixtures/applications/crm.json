    "workflows": [
      {
        "id": "wf_crm_qualify",
        "key": "crm_qualify_lead",
        "name": "Qualify a lead",
        "trigger": {
          "kind": "event",
          "event": "vortex.crm.people.lead.received",
          "record_type": "vortex.crm.people:lead",
          "inputs": [],
          "condition": null,
          "duplicate_protection": "required"
        },
        "run_as": "triggering_account",
        "maximum_nesting_depth": 5,
        "nodes": [
          {
            "id": "n1",
            "type": "start",
            "config": {}
          },
          {
            "id": "n2",
            "type": "condition",
            "config": {
              "field": "vortex.crm.people:lead.score",
              "operator": "greater_than_or_equal",
              "value": 50
            }
          },
          {
            "id": "n4",
            "type": "request_form",
            "config": {
              "page": "crm_qualify_lead",
              "responder_permission": "vortex.crm.people.lead.convert",
              "due_in_seconds": 86400,
              "timeout_outcome": "expired",
              "outputs": [
                {
                  "key": "first_name",
                  "type": "text"
                },
                {
                  "key": "last_name",
                  "type": "text"
                },
                {
                  "key": "company",
                  "type": "record_reference",
                  "record_types": [
                    "vortex.crm.organisations:company"
                  ]
                }
              ]
            }
          },
          {
            "id": "n5",
            "type": "decision_table",
            "config": {
              "decisions": [
                {
                  "when": {
                    "field": "vortex.crm.people:lead.score",
                    "operator": "greater_than_or_equal",
                    "value": 80
                  },
                  "output": "qualified"
                },
                {
                  "when": {
                    "field": "vortex.crm.people:lead.score",
                    "operator": "greater_than_or_equal",
                    "value": 50
                  },
                  "output": "review"
                }
              ]
            }
          },
          {
            "id": "n6",
            "type": "run_action",
            "config": {
              "action": "vortex.crm.people.lead.convert",
              "subject": {
                "source": "current_record"
              },
              "inputs": {
                "first_name": {
                  "source": "node_output",
                  "node": "n4",
                  "output": "first_name"
                },
                "last_name": {
                  "source": "node_output",
                  "node": "n4",
                  "output": "last_name"
                },
                "company": {
                  "source": "node_output",
                  "node": "n4",
                  "output": "company"
                }
              }
            }
          },
          {
            "id": "n8",
            "type": "call_connection",
            "config": {
              "connection": "crm_email",
              "operation": "send_template",
              "inputs": {
                "recipient": {
                  "source": "literal",
                  "value": "recipient@example.test"
                },
                "template_key": {
                  "source": "literal",
                  "value": "lead_qualified"
                },
                "variables": {
                  "source": "literal",
                  "value": {}
                }
              }
            }
          },
          {
            "id": "n9",
            "type": "stop",
            "config": {
              "reason_code": "completed"
            }
          }
