    "workflows": [
      {
        "id": "wf_sd_intake",
        "key": "service_desk_case_intake",
        "name": "Triage a new case",
        "trigger": {
          "kind": "event",
          "event": "vortex.service_desk.cases.case.created",
          "record_type": "vortex.service_desk.cases:case",
          "inputs": [],
          "condition": null,
          "duplicate_protection": "required"
        },
        "run_as": "system_with_source_authority",
        "maximum_nesting_depth": 5,
        "nodes": [
          {
            "id": "i1",
            "type": "start",
            "config": {}
          },
          {
            "id": "i2",
            "type": "set_values",
            "config": {
              "record": {
                "source": "current_record"
              },
              "values": {
                "vortex.service_desk.cases:case.status": {
                  "source": "literal",
                  "value": "triage"
                }
              }
            }
          },
          {
            "id": "i3",
            "type": "change_record",
            "config": {
              "record_type": "vortex.service_desk.cases:case",
              "record": {
                "source": "current_record"
              },
              "values": {
                "status": {
                  "source": "literal",
                  "value": "triage"
                }
              }
            }
          },
          {
            "id": "i6",
            "type": "start_workflow",
            "config": {
              "workflow": "service_desk_escalation"
            }
          },
          {
            "id": "i8",
            "type": "stop",
            "config": {
              "reason_code": "completed"
            }
          }
        ],
        "edges": [
          [
            "i1",
            "i2"
          ],
          [
            "i2",
            "i3"
          ],
          [
            "i3",
            "i6"
          ],
          [
            "i6",
            "i8"
          ]
        ]
      },
      {
        "id": "wf_sd_escalation",
        "key": "service_desk_escalation",
        "name": "Escalate an overdue case",
        "trigger": {
          "kind": "workflow",
          "workflow": "service_desk_case_intake",
          "inputs": [],
          "condition": null,
          "duplicate_protection": "required"
        },
        "run_as": "system_with_source_authority",
        "maximum_nesting_depth": 5,
        "nodes": [
          {
            "id": "e1",
            "type": "start",
            "config": {}
          },
          {
            "id": "e2",
            "type": "wait_until",
            "config": {
              "field": "vortex.service_desk.cases:case.resolution_due_at"
            }
          },
          {
            "id": "e3",
            "type": "condition",
            "config": {
              "field": "vortex.service_desk.cases:case.status",
              "operator": "not_in",
              "value": [
                "resolved",
                "closed"
              ]
            }
          },
          {
            "id": "e4",
            "type": "delay",
            "config": {
              "seconds": 900
            }
          },
          {
            "id": "e5",
            "type": "call_connection",
            "config": {
              "connection": "service_desk_webhook",
              "operation": "post_json",
              "inputs": {
                "event_key": {
                  "source": "literal",
                  "value": "case_escalated"
                },
                "payload": {
                  "source": "literal",
                  "value": {}
                }
              }
            }
          },
          {
            "id": "e6",
            "type": "call_connection",
            "config": {
              "connection": "service_desk_email",
              "operation": "send_template",
              "inputs": {
                "recipient": {
                  "source": "literal",
                  "value": "owner@example.test"
                },
                "template_key": {
                  "source": "literal",
                  "value": "case_escalated"
                },
                "variables": {
