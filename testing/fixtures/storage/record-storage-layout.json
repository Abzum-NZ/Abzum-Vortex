      "concurrency_number",
      "created_at",
      "created_by",
      "updated_at",
      "updated_by",
      "deleted_at",
      "deleted_by",
      "removal_due_at"
    ],
    "scope_keys": {
      "organisation_shared": ["organisation_id"],
      "application_contained": ["organisation_id", "application_root_id"]
    },
    "tables": [
      {"record_type":"vortex.crm.organisations:company","storage_contract_id":"srt_00000001","table":"record_data.rt_srt_00000001","storage_scope":"organisation_shared"},
      {"record_type":"vortex.crm.people:contact","storage_contract_id":"srt_00000002","table":"record_data.rt_srt_00000002","storage_scope":"organisation_shared"},
