      {"record_type":"vortex.crm.tags:tag","storage_contract_id":"srt_00000007","table":"record_data.rt_srt_00000007","storage_scope":"organisation_shared"},
      {"record_type":"vortex.crm.tags:record_tag","storage_contract_id":"srt_00000008","table":"record_data.rt_srt_00000008","storage_scope":"organisation_shared"},
