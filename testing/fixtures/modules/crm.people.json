{
  "schema_version": "2.0.0",
  "kind": "module",
  "root_id": "mod_crm_people",
  "key": "vortex.crm.people",
  "version": "1.0.0",
  "revision": 1,
  "state": "published",
  "content_fingerprint": "fixture:vortex.crm.people:1.0.0",
  "body": {
    "name": "CRM People",
    "description": "Contacts and unqualified leads, shared by compatible applications in one organisation.",
    "category": "CRM",
    "dependencies": [
      {
        "module": "vortex.crm.organisations",
        "version": "1.0.0"
      }
    ],
    "record_types": [
      {
        "id": "rt_crm_contact",
        "storage_contract_id": "srt_00000002",
        "key": "contact",
        "name": "Contact",
        "plural_name": "Contacts",
        "description": "A person associated with a company.",
        "storage_scope": "organisation_shared",
        "ownership_mode": "team",
        "title_field": "full_name",
        "standard_actions": [
          "create",
          "read",
          "update",
          "soft_delete",
          "restore",
          "export"
        ],
        "fields": [
          {
            "id": "fld_contact_number",
            "key": "contact_number",
            "type": "reference_number",
            "label": "Contact number",
            "required": true,
            "unique": true,
            "filterable": true,
            "sortable": true,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "prefix": "CON-",
              "digits": 7
            }
          },
          {
            "id": "fld_contact_first",
            "key": "first_name",
            "type": "text",
            "label": "First name",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "first",
            "personal_data": "personal",
            "public_display": "allowed",
            "settings": {
              "max_length": 80
            }
          },
          {
            "id": "fld_contact_last",
            "key": "last_name",
            "type": "text",
            "label": "Last name",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "first",
            "personal_data": "personal",
            "public_display": "allowed",
            "settings": {
              "max_length": 80
            }
          },
          {
            "id": "fld_contact_full",
            "key": "full_name",
            "type": "calculation",
            "label": "Full name",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "first",
            "personal_data": "personal",
            "public_display": "allowed",
            "settings": {
              "result_type": "text",
              "expression": {
                "operation": "join_text",
                "fields": [
                  "first_name",
                  "last_name"
