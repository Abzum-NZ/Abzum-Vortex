{
  "source_contract_version": "1.0.0",
  "kind": "module",
  "root_alias": "mod_crm_people",
  "key": "vortex.crm.people",
  "body": {
    "name": "CRM People",
    "description": "Contacts and unqualified leads, shared by compatible applications in one organisation.",
    "dependencies": [
      {
        "dependency_key": "organisations",
        "module": "vortex.crm.organisations",
        "version": {
          "selection": "exact",
          "version": "1.0.0"
        }
      }
    ],
    "record_types": [
      {
        "id": "rt_crm_contact",
        "storage_contract_id": "srt_00000002",
        "key": "contact",
        "name": "Contact",
        "plural_name": "Contacts",
        "storage_scope": "organisation_shared",
        "ownership_mode": "team",
        "title_field": "full_name",
        "standard_actions": [
          "create",
          "read",
          "update",
          "soft_delete",
          "restore",
          "export"
        ],
        "fields": [
          {
            "id": "fld_contact_number",
            "key": "contact_number",
            "type": "reference_number",
            "label": "Contact number",
            "required": true,
            "unique": true,
            "filterable": true,
            "sortable": true,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "prefix": "CON-",
              "digits": 7
            }
          },
          {
            "id": "fld_contact_first",
            "key": "first_name",
            "type": "text",
            "label": "First name",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "first",
            "personal_data": "personal",
            "public_display": "allowed",
            "settings": {
              "max_length": 80
            }
          },
          {
            "id": "fld_contact_last",
            "key": "last_name",
            "type": "text",
            "label": "Last name",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "first",
            "personal_data": "personal",
            "public_display": "allowed",
            "settings": {
              "max_length": 80
            }
          },
          {
            "id": "fld_contact_full",
            "key": "full_name",
            "type": "calculation",
            "label": "Full name",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "first",
            "personal_data": "personal",
            "public_display": "allowed",
            "settings": {
              "result_type": "text",
              "expression": {
                "operation": "join_text",
                "fields": [
                  "first_name",
                  "last_name"
                ],
                "separator": " "
              }
            }
          },
          {
            "id": "fld_contact_email",
            "key": "email",
            "type": "email_address",
            "label": "Email",
            "required": true,
            "unique": true,
            "filterable": true,
            "sortable": true,
            "search_priority": "first",
            "personal_data": "personal",
            "public_display": "allowed",
            "settings": {}
          },
          {
            "id": "fld_contact_phone",
            "key": "phone",
            "type": "phone_number",
            "label": "Phone",
            "required": false,
            "unique": false,
            "filterable": false,
            "sortable": false,
            "search_priority": "normal",
            "personal_data": "personal",
            "public_display": "refused",
            "settings": {
              "default_country": "NZ"
            }
          },
          {
            "id": "fld_contact_company",
            "key": "company",
            "type": "link",
            "label": "Company",
            "required": false,
            "unique": false,
            "filterable": true,
            "sortable": false,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "target": "vortex.crm.organisations:company",
              "reverse_key": "contacts",
              "on_parent_delete": "empty_optional"
            }
          },
          {
            "id": "fld_contact_owner",
            "key": "relationship_owner",
            "type": "link_to_person",
            "label": "Relationship owner",
            "required": false,
            "unique": false,
            "filterable": true,
            "sortable": false,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "audience": "organisation_accounts",
              "on_person_deactivation": "retain_reference",
              "application_root_required": false
            }
          },
          {
            "id": "fld_contact_consent",
            "key": "email_consent",
            "type": "yes_no",
            "label": "Email consent",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": false,
            "personal_data": "personal",
            "public_display": "refused",
            "settings": {},
            "default": false
          },
          {
            "id": "fld_contact_notes",
            "key": "notes",
            "type": "long_text",
            "label": "Notes",
            "required": false,
            "unique": false,
            "filterable": false,
            "sortable": false,
            "search_priority": "normal",
            "personal_data": "sensitive",
            "public_display": "refused",
            "settings": {
              "max_length": 5000
            }
          }
        ],
        "custom_actions": [],
        "relationships": [
          {
            "id": "fld_contact_company_relationship",
            "key": "company",
            "from_field": "company",
            "to_record_type": "vortex.crm.organisations:company",
            "cardinality": "many_to_one",
            "on_parent_delete": "empty_optional"
          }
        ]
      },
      {
        "id": "rt_crm_lead",
        "storage_contract_id": "srt_00000003",
        "key": "lead",
        "name": "Lead",
        "plural_name": "Leads",
        "storage_scope": "application_contained",
        "ownership_mode": "organisation_account",
        "title_field": "display_name",
        "standard_actions": [
          "create",
          "read",
          "update",
          "soft_delete",
          "restore",
          "export"
        ],
        "fields": [
          {
            "id": "fld_lead_number",
            "key": "lead_number",
            "type": "reference_number",
            "label": "Lead number",
            "required": true,
            "unique": true,
            "filterable": true,
            "sortable": true,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "prefix": "LEA-",
              "digits": 7
            }
          },
          {
            "id": "fld_lead_name",
            "key": "display_name",
            "type": "text",
            "label": "Name",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "first",
            "personal_data": "personal",
            "public_display": "refused",
            "settings": {
              "max_length": 160
            }
          },
          {
            "id": "fld_lead_company",
            "key": "company_name",
            "type": "text",
            "label": "Company name",
            "required": false,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "max_length": 255
            }
          },
          {
            "id": "fld_lead_email",
            "key": "email",
            "type": "email_address",
            "label": "Email",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": false,
            "search_priority": "first",
            "personal_data": "personal",
            "public_display": "refused",
            "settings": {}
          },
          {
            "id": "fld_lead_source",
            "key": "source",
            "type": "choice",
            "label": "Source",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": false,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "options": [
                {
                  "value": "web",
                  "label": "Web form"
                },
                {
                  "value": "referral",
                  "label": "Referral"
                },
                {
                  "value": "event",
                  "label": "Event"
                },
                {
                  "value": "manual",
                  "label": "Manual"
                }
              ]
            }
          },
          {
            "id": "fld_lead_interests",
            "key": "interests",
            "type": "several_choices",
            "label": "Interests",
            "required": false,
            "unique": false,
            "filterable": true,
            "sortable": false,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "options": [
                {
                  "value": "software",
                  "label": "Software"
                },
                {
                  "value": "services",
                  "label": "Services"
                },
                {
                  "value": "support",
                  "label": "Support"
                }
              ]
            }
          },
          {
            "id": "fld_lead_score",
            "key": "score",
            "type": "whole_number",
            "label": "Score",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "minimum": 0,
              "maximum": 100
            },
            "default": 0
          },
          {
            "id": "fld_lead_status",
            "key": "status",
            "type": "choice",
            "label": "Status",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "options": [
                {
                  "value": "new",
                  "label": "New"
                },
                {
                  "value": "working",
                  "label": "Working"
                },
                {
                  "value": "qualified",
                  "label": "Qualified"
                },
                {
                  "value": "unqualified",
                  "label": "Unqualified"
                },
                {
                  "value": "converted",
                  "label": "Converted"
                }
              ]
            },
            "default": "new"
          },
          {
            "id": "fld_lead_reason",
            "key": "unqualified_reason",
            "type": "long_text",
            "label": "Unqualified reason",
            "required": false,
            "unique": false,
            "filterable": false,
            "sortable": false,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "max_length": 1000
            }
          },
          {
            "id": "fld_lead_received",
            "key": "received_at",
            "type": "date_time",
            "label": "Received at",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {}
          }
        ],
        "custom_actions": [
          "act_lead_convert"
        ],
        "relationships": []
      }
    ],
    "permissions": [
      {
        "id": "perm_contact_create",
        "key": "vortex.crm.people.contact.create",
        "label": "Create contact",
        "description": "Allows the standard create operation for contacts.",
        "record_type": "contact",
        "action_kind": "create",
        "administrative": false
      },
      {
        "id": "perm_contact_read",
        "key": "vortex.crm.people.contact.read",
        "label": "Read contact",
        "description": "Allows the standard read operation for contacts.",
        "record_type": "contact",
        "action_kind": "read",
        "administrative": false
      },
      {
        "id": "perm_contact_update",
        "key": "vortex.crm.people.contact.update",
        "label": "Update contact",
        "description": "Allows the standard update operation for contacts.",
        "record_type": "contact",
        "action_kind": "update",
        "administrative": false
      },
      {
        "id": "perm_contact_soft_delete",
        "key": "vortex.crm.people.contact.soft_delete",
        "label": "Soft Delete contact",
        "description": "Allows the standard soft_delete operation for contacts.",
        "record_type": "contact",
        "action_kind": "delete",
        "administrative": false
      },
      {
        "id": "perm_contact_restore",
        "key": "vortex.crm.people.contact.restore",
        "label": "Restore contact",
        "description": "Allows the standard restore operation for contacts.",
        "record_type": "contact",
        "action_kind": "restore",
        "administrative": false
      },
      {
        "id": "perm_contact_export",
        "key": "vortex.crm.people.contact.export",
        "label": "Export contact",
        "description": "Allows the standard export operation for contacts.",
        "record_type": "contact",
        "action_kind": "export",
        "administrative": false
      },
      {
        "id": "perm_lead_create",
        "key": "vortex.crm.people.lead.create",
        "label": "Create lead",
        "description": "Allows the standard create operation for leads.",
        "record_type": "lead",
        "action_kind": "create",
        "administrative": false
      },
      {
        "id": "perm_lead_read",
        "key": "vortex.crm.people.lead.read",
        "label": "Read lead",
        "description": "Allows the standard read operation for leads.",
        "record_type": "lead",
        "action_kind": "read",
        "administrative": false
      },
      {
        "id": "perm_lead_update",
        "key": "vortex.crm.people.lead.update",
        "label": "Update lead",
        "description": "Allows the standard update operation for leads.",
        "record_type": "lead",
        "action_kind": "update",
        "administrative": false
      },
      {
        "id": "perm_lead_soft_delete",
        "key": "vortex.crm.people.lead.soft_delete",
        "label": "Soft Delete lead",
        "description": "Allows the standard soft_delete operation for leads.",
        "record_type": "lead",
        "action_kind": "delete",
        "administrative": false
      },
      {
        "id": "perm_lead_restore",
        "key": "vortex.crm.people.lead.restore",
        "label": "Restore lead",
        "description": "Allows the standard restore operation for leads.",
        "record_type": "lead",
        "action_kind": "restore",
        "administrative": false
      },
      {
        "id": "perm_lead_export",
        "key": "vortex.crm.people.lead.export",
        "label": "Export lead",
        "description": "Allows the standard export operation for leads.",
        "record_type": "lead",
        "action_kind": "export",
        "administrative": false
      },
      {
        "id": "perm_named_1_convert",
        "key": "vortex.crm.people.lead.convert",
        "label": "Convert a lead",
        "description": "Allows the named convert operation.",
        "record_type": "lead",
        "action_kind": "named",
        "named_action": "convert",
        "administrative": false
      },
      {
        "id": "perm_named_2_view_sensitive_notes",
        "key": "vortex.crm.people.contact.view_sensitive_notes",
        "label": "View sensitive contact notes",
        "description": "Allows the named view_sensitive_notes operation.",
        "record_type": "contact",
        "action_kind": "named",
        "named_action": "view_sensitive_notes",
        "administrative": false
      }
    ],
    "actions": [
      {
        "id": "act_lead_convert",
        "key": "vortex.crm.people.lead.convert",
        "label": "Convert lead",
        "record_type": "lead",
        "permission": "vortex.crm.people.lead.convert",
        "inputs": [
          {
            "key": "first_name",
            "label": "First Name",
            "required": true,
            "type": "text"
          },
          {
            "key": "last_name",
            "label": "Last Name",
            "required": true,
            "type": "text"
          },
          {
            "key": "company",
            "label": "Company",
            "required": false,
            "type": "record_reference",
            "record_types": [
              "vortex.crm.organisations:company"
            ]
          }
        ],
        "effects": [
          {
            "kind": "create_record",
            "record_type": "vortex.crm.people:contact",
            "values": {
              "first_name": {
                "source": "input",
                "input": "first_name"
              },
              "last_name": {
                "source": "input",
                "input": "last_name"
              },
              "email": {
                "source": "subject_field",
                "field": "email"
              },
              "company": {
                "source": "input",
                "input": "company"
              }
            }
          },
          {
            "kind": "set_field",
            "field": "status",
            "value": {
              "source": "literal",
              "value": "converted"
            }
          },
          {
            "kind": "announce_event",
            "event": "vortex.crm.people.lead.converted"
          }
        ],
        "shareable": false
      }
    ],
    "events": [
      {
        "id": "evt_contact_created",
        "key": "vortex.crm.people.contact.created",
        "record_type": "contact",
        "carries": [
          "contact_number",
          "company"
        ],
        "personal_or_sensitive_values_allowed": false
      },
      {
        "id": "evt_lead_received",
        "key": "vortex.crm.people.lead.received",
        "record_type": "lead",
        "carries": [
          "lead_number",
          "source"
        ],
        "personal_or_sensitive_values_allowed": false
      },
      {
        "id": "evt_lead_converted",
        "key": "vortex.crm.people.lead.converted",
        "record_type": "lead",
        "carries": [
          "lead_number"
        ],
        "personal_or_sensitive_values_allowed": false
      }
    ],
    "rules": [
      {
        "id": "rule_lead_reason",
        "key": "unqualified_reason_required",
        "record_type": "lead",
        "trigger": "change",
        "priority": 100,
        "condition": {
          "all": [
            {
              "field": "status",
              "operator": "equals",
              "value": "unqualified"
            },
            {
              "field": "unqualified_reason",
              "operator": "is_empty"
            }
          ]
        },
        "effect": {
          "kind": "refuse",
          "reason_code": "unqualified_reason_required"
        }
      }
    ],
    "extension_points": [
      {
        "id": "ext_contact_fields",
        "key": "contact_fields",
        "record_type": "contact",
        "accepts": [
          "field"
        ]
      },
      {
        "id": "ext_lead_actions",
        "key": "lead_actions",
        "record_type": "lead",
        "accepts": [
          "action"
        ]
      }
    ],
    "sharing_conditions": []
  }
}
