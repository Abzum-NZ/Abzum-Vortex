    "actions": [
      {
        "id": "act_opp_mark_won",
        "key": "vortex.crm.opportunities.opportunity.mark_won",
        "label": "Mark opportunity won",
        "record_type": "opportunity",
        "permission": "vortex.crm.opportunities.opportunity.mark_won",
        "inputs": [],
        "effects": [
          {
            "kind": "set_field",
            "field": "stage",
            "value": {
              "source": "literal",
              "value": "won"
            }
          },
          {
            "kind": "announce_event",
            "event": "vortex.crm.opportunities.opportunity.won"
          }
        ],
        "shareable": false
      }
    ],
    "events": [
      {
        "id": "evt_opp_created",
        "key": "vortex.crm.opportunities.opportunity.created",
        "record_type": "opportunity",
        "carries": [
          "opportunity_number",
          "company",
          "value",
          "stage"
        ],
        "personal_or_sensitive_values_allowed": false
      },
      {
        "id": "evt_opp_stage",
        "key": "vortex.crm.opportunities.opportunity.stage_changed",
        "record_type": "opportunity",
        "carries": [
          "opportunity_number",
          "stage",
          "value"
        ],
        "personal_or_sensitive_values_allowed": false
      },
      {
        "id": "evt_opp_won",
        "key": "vortex.crm.opportunities.opportunity.won",
        "record_type": "opportunity",
        "carries": [
          "opportunity_number",
          "company",
          "net_value"
        ],
        "personal_or_sensitive_values_allowed": false
      }
