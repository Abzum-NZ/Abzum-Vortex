            "settings": {
              "target": "vortex.crm.people:contact",
              "reverse_key": "opportunity_roles",
              "on_parent_delete": "soft_delete_dependent"
            }
          },
          {
            "id": "fld_oc_role",
            "key": "role",
            "type": "choice",
            "label": "Role",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "options": [
                {
                  "value": "decision_maker",
