    "rules": [
      {
        "id": "rule_opp_discount",
        "key": "large_discount_warning",
        "record_type": "opportunity",
        "trigger": "change",
        "priority": 100,
        "condition": {
          "field": "discount_percent",
          "operator": "greater_than",
          "value": 15
        },
        "effect": {
          "kind": "warn",
          "message": "large_discount_review"
        }
      }
