              "max_file_size_mb": 25,
              "multiple": true,
              "max_files": 20
            }
          }
        ]
      },
      {
        "id": "rt_crm_opportunity_contact",
        "storage_contract_id": "srt_00000005",
        "key": "opportunity_contact",
        "name": "Opportunity contact",
        "plural_name": "Opportunity contacts",
        "description": "A contact's role in an opportunity.",
        "storage_scope": "application_contained",
        "ownership_mode": "inherited",
        "ownership_relationship": "opportunity",
        "title_field": "role",
        "standard_actions": [
          "create",
          "read",
          "update",
          "soft_delete",
          "restore",
          "export"
        ],
        "fields": [
          {
            "id": "fld_oc_opp",
            "key": "opportunity",
            "type": "link",
            "label": "Opportunity",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": false,
