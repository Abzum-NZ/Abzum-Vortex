        "key": "opportunity",
        "name": "Opportunity",
        "plural_name": "Opportunities",
        "description": "A potential sale being progressed.",
        "storage_scope": "application_contained",
        "ownership_mode": "team",
        "title_field": "name",
        "standard_actions": [
          "create",
          "read",
          "update",
          "soft_delete",
          "restore",
          "export"
        ],
        "fields": [
          {
            "id": "fld_opp_number",
            "key": "opportunity_number",
            "type": "reference_number",
            "label": "Opportunity number",
            "required": true,
            "unique": true,
            "filterable": true,
            "sortable": true,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "prefix": "OPP-",
              "digits": 7
            }
          },
          {
            "id": "fld_opp_name",
            "key": "name",
            "type": "text",
            "label": "Opportunity name",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "first",
