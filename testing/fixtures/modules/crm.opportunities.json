            "unique": false,
            "filterable": true,
            "sortable": false,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "target": "vortex.crm.organisations:company",
              "reverse_key": "opportunities",
              "on_parent_delete": "refuse"
