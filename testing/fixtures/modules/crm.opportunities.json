            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "currency_mode": "organisation_default",
              "minimum": 0
            }
          },
          {
            "id": "fld_opp_discount",
            "key": "discount_percent",
            "type": "decimal_number",
            "label": "Discount percentage",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "minimum": 0,
              "maximum": 100,
