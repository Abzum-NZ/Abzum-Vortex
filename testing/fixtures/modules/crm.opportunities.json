            }
          },
          {
            "id": "fld_opp_probability",
            "key": "probability",
            "type": "whole_number",
            "label": "Probability",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "minimum": 0,
              "maximum": 100,
              "default": 10
            }
          },
