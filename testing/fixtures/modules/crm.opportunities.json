                  "value": "qualified",
                  "label": "Qualified"
                },
                {
                  "value": "proposal",
                  "label": "Proposal"
                },
                {
                  "value": "negotiation",
                  "label": "Negotiation"
                },
                {
                  "value": "won",
                  "label": "Won"
                },
                {
                  "value": "lost",
                  "label": "Lost"
                }
              ]
            }
          },
          {
            "id": "fld_opp_close",
            "key": "expected_close_date",
            "type": "date",
            "label": "Expected close date",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {}
          },
