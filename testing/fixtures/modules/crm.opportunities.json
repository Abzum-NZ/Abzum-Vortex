                },
                {
                  "value": "influencer",
                  "label": "Influencer"
                },
                {
                  "value": "procurement",
                  "label": "Procurement"
                }
              ]
            }
          }
        ]
      }
    ],
    "permissions": [
      {
        "key": "vortex.crm.opportunities.opportunity.approve_discount",
        "record_type": "opportunity",
        "label": "Approve a discount above 15 percent"
      },
      {
        "key": "vortex.crm.opportunities.opportunity.mark_won",
        "record_type": "opportunity",
        "label": "Mark an opportunity as won"
      }
    ],
    "actions": [
      {
        "id": "act_opp_mark_won",
        "key": "vortex.crm.opportunities.opportunity.mark_won",
        "label": "Mark opportunity won",
        "record_type": "opportunity",
        "permission": "vortex.crm.opportunities.opportunity.mark_won",
        "inputs": [],
        "effects": [
          {"kind":"set_field","field":"stage","value":{"source":"literal","value":"won"}},
          {"kind":"announce_event","event":"vortex.crm.opportunities.opportunity.won"}
        ],
        "shareable": false
      }
    ],
    "events": [
      {
        "id": "evt_opp_created",
        "key": "vortex.crm.opportunities.opportunity.created",
        "record_type": "opportunity",
        "carries": [
          "opportunity_number",
          "company",
          "value",
          "stage"
        ]
      },
      {
        "id": "evt_opp_stage",
        "key": "vortex.crm.opportunities.opportunity.stage_changed",
        "record_type": "opportunity",
        "carries": [
          "opportunity_number",
          "stage",
          "value"
        ]
      },
      {
        "id": "evt_opp_won",
        "key": "vortex.crm.opportunities.opportunity.won",
        "record_type": "opportunity",
        "carries": [
          "opportunity_number",
          "company",
          "net_value"
        ]
      }
    ],
    "rules": [
      {
        "id": "rule_opp_discount",
        "key": "large_discount_warning",
        "record_type": "opportunity",
        "trigger": "change",
        "priority": 100,
        "condition": {
          "field": "discount_percent",
          "operator": "greater_than",
          "value": 15
        },
        "effect": {"kind":"warn","message":"large_discount_review"}
      }
    ],
    "extension_points": [
      {
        "id": "ext_opp_fields",
        "key": "opportunity_fields",
        "record_type": "opportunity",
        "accepts": [
          "field"
        ]
      },
      {
        "id": "ext_opp_actions",
        "key": "opportunity_actions",
        "record_type": "opportunity",
        "accepts": [
          "action"
        ]
      }
    ]
