            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "type": "date_time",
            "settings": {}
          }
        ],
        "relationships": [
          {
            "id": "fld_article_case_article_relationship",
            "key": "article",
            "from_field": "article",
            "to_record_type": "vortex.service_desk.knowledge:article",
