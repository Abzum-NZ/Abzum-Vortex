    "actions": [
      {
        "id": "act_article_publish",
        "key": "vortex.service_desk.knowledge.article.publish",
        "label": "Publish article",
        "record_type": "article",
        "permission": "vortex.service_desk.knowledge.article.publish",
        "shareable": false,
        "inputs": [],
        "effects": [
          {
            "kind": "set_field",
            "field": "status",
            "value": {
              "source": "literal",
              "value": "published"
            }
          },
          {
            "kind": "announce_event",
            "event": "vortex.service_desk.knowledge.article.published"
          }
        ]
      }
    ],
    "events": [
      {
        "id": "evt_article_published",
        "key": "vortex.service_desk.knowledge.article.published",
        "record_type": "article",
        "carries": [
          "article_number",
          "title",
          "public"
        ],
        "personal_or_sensitive_values_allowed": false
      }
    ],
    "rules": [
      {
        "id": "rule_article_public",
        "key": "only_published_articles_are_public",
        "record_type": "article",
        "trigger": "change",
        "priority": 100,
        "condition": {
          "all": [
            {
              "field": "public",
              "operator": "equals",
              "value": true
            },
            {
              "field": "status",
              "operator": "not_equals",
              "value": "published"
            }
          ]
        },
        "effect": {
          "kind": "refuse",
          "reason_code": "published_state_required"
        }
      }
    ],
    "extension_points": [
