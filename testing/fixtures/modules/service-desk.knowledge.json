{
  "schema_version": "2.0.0",
  "kind": "module",
  "root_id": "mod_service_desk_knowledge",
  "key": "vortex.service_desk.knowledge",
  "version": "1.0.0",
  "revision": 1,
  "state": "published",
  "content_fingerprint": "fixture:vortex.service_desk.knowledge:1.0.0",
  "body": {
    "name": "Service Desk Knowledge",
    "description": "Reviewed knowledge articles linked to cases.",
    "category": "Service Desk",
    "dependencies": [
      {
        "module": "vortex.service_desk.cases",
        "version": "1.0.0"
      }
    ],
    "record_types": [
      {
        "id": "rt_sd_article",
        "storage_contract_id": "srt_00000013",
        "key": "article",
        "name": "Article",
        "plural_name": "Articles",
        "description": "A reviewed answer or procedure.",
        "storage_scope": "application_contained",
        "ownership_mode": "team",
        "title_field": "title",
        "standard_actions": [
          "create",
          "read",
          "update",
          "soft_delete",
          "restore",
          "export"
        ],
        "fields": [
          {
            "id": "fld_article_number",
            "key": "article_number",
            "type": "reference_number",
            "label": "Article number",
            "required": true,
            "unique": true,
            "filterable": true,
            "sortable": true,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "prefix": "KBA-",
              "digits": 7
            }
          },
          {
            "id": "fld_article_title",
            "key": "title",
            "type": "text",
            "label": "Title",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "first",
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "max_length": 255
            }
          },
          {
            "id": "fld_article_body",
            "key": "body",
            "type": "formatted_text",
            "label": "Article",
            "required": true,
            "unique": false,
            "filterable": false,
            "sortable": false,
            "search_priority": "first",
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "allowed_blocks": [
                "paragraph",
                "heading",
                "list",
                "table",
                "link",
                "attachment"
              ]
            }
          },
          {
            "id": "fld_article_status",
            "key": "status",
            "type": "choice",
            "label": "Status",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "default": "draft",
              "options": [
                {
                  "value": "draft",
                  "label": "Draft"
                },
                {
                  "value": "review",
                  "label": "In review"
                },
                {
                  "value": "published",
                  "label": "Published"
                },
                {
                  "value": "retired",
                  "label": "Retired"
                }
              ]
            }
          },
          {
            "id": "fld_article_public",
            "key": "public",
            "type": "yes_no",
            "label": "Public",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "default": false
            }
          },
          {
            "id": "fld_article_review",
            "key": "review_date",
            "type": "date",
            "label": "Review date",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {}
          },
          {
            "id": "fld_article_author",
            "key": "author",
            "type": "link_to_person",
            "label": "Author",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": false,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "audience": "application_accounts",
              "on_person_deactivation": "retain_reference"
            }
          },
          {
            "id": "fld_article_files",
            "key": "attachments",
            "type": "attachment",
            "label": "Attachments",
            "required": false,
            "unique": false,
            "filterable": false,
            "sortable": false,
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "allowed_kinds": [
                "image",
                "document",
                "spreadsheet",
                "presentation",
                "audio",
                "video",
                "archive",
                "text",
                "other"
              ],
              "max_file_size_mb": 25,
              "multiple": true,
              "max_files": 10
            }
          }
        ]
      },
      {
        "id": "rt_sd_article_case",
        "storage_contract_id": "srt_00000014",
        "key": "article_case",
        "name": "Article case link",
        "plural_name": "Article case links",
        "description": "An article used to resolve a case.",
        "storage_scope": "application_contained",
        "ownership_mode": "inherited",
        "ownership_relationship": "article",
        "title_field": "linked_at",
        "standard_actions": [
          "create",
          "read",
          "soft_delete",
          "restore",
          "export"
        ],
        "fields": [
          {
            "id": "fld_article_case_article",
            "key": "article",
            "type": "link",
            "label": "Article",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": false,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "target": "vortex.service_desk.knowledge:article",
              "reverse_key": "case_links",
              "on_parent_delete": "soft_delete_dependent"
            }
          },
          {
            "id": "fld_article_case_case",
            "key": "case",
            "type": "link",
            "label": "Case",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": false,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "target": "vortex.service_desk.cases:case",
              "reverse_key": "knowledge_links",
              "on_parent_delete": "soft_delete_dependent"
            }
          },
          {
            "id": "fld_article_case_at",
            "key": "linked_at",
            "type": "date_time",
            "label": "Linked at",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "default": "now"
            }
          }
        ]
      }
    ],
    "permissions": [
      {
        "key": "vortex.service_desk.knowledge.article.publish",
        "record_type": "article",
        "label": "Publish a knowledge article"
      }
    ],
    "actions": [
      {
        "id": "act_article_publish",
        "key": "vortex.service_desk.knowledge.article.publish",
        "record_type": "article",
        "permission": "vortex.service_desk.knowledge.article.publish",
        "inputs": [],
        "effects": [
          "change_status",
          "emit_event"
        ],
        "shareable": false
      }
    ],
    "events": [
      {
        "id": "evt_article_published",
        "key": "vortex.service_desk.knowledge.article.published",
        "record_type": "article",
        "carries": [
          "article_number",
          "title",
          "public"
        ]
      }
    ],
    "rules": [
      {
        "id": "rule_article_public",
        "key": "only_published_articles_are_public",
        "record_type": "article",
        "moment": "saving",
        "condition": {
          "all": [
            {
              "field": "public",
              "operator": "equals",
              "value": true
            },
            {
              "field": "status",
              "operator": "not_equals",
              "value": "published"
            }
          ]
        },
        "effect": "refuse",
        "message": "Publish the article before making it public."
      }
    ],
    "extension_points": [
      {
        "id": "ext_article_fields",
        "key": "article_fields",
        "record_type": "article",
        "accepts": [
          "field"
        ]
      }
    ]
  }
}
