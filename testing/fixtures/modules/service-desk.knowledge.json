{
  "source_contract_version": "2.0.0",
  "root_alias": "mod_service_desk_knowledge",
  "key": "vortex.service_desk.knowledge",
  "kind": "module",
  "body": {
    "name": "Service Desk Knowledge",
    "description": "Reviewed knowledge articles linked to cases.",
    "dependencies": [
      {
        "dependency_key": "cases",
        "module": "vortex.service_desk.cases",
        "version": {
          "selection": "exact",
          "version": "2.0.0"
        }
      }
    ],
    "record_types": [
      {
        "id": "rt_sd_article",
        "key": "article",
        "name": "Article",
        "plural_name": "Articles",
        "title_field": "title",
        "storage_contract_id": "srt_00000013",
        "storage_scope": "application_contained",
        "ownership_mode": "team",
        "standard_actions": [
          "create",
          "read",
          "update",
          "soft_delete",
          "restore",
          "export"
        ],
        "custom_actions": [
          "act_article_publish"
        ],
        "fields": [
          {
            "id": "fld_article_number",
            "key": "article_number",
            "label": "Article number",
            "required": true,
            "unique": true,
            "filterable": true,
            "sortable": true,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "allowed",
            "type": "reference_number",
            "settings": {
              "prefix": "KBA-",
              "digits": 7
            }
          },
          {
            "id": "fld_article_title",
            "key": "title",
            "label": "Title",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "first",
            "personal_data": "none",
            "public_display": "allowed",
            "type": "text",
            "settings": {
              "max_length": 255
            }
          },
          {
            "id": "fld_article_body",
            "key": "body",
            "label": "Article",
            "required": true,
            "unique": false,
            "filterable": false,
            "sortable": false,
            "search_priority": "first",
            "personal_data": "none",
            "public_display": "allowed",
            "type": "formatted_text",
            "settings": {
              "allowed_blocks": [
                "paragraph",
                "heading",
                "list",
                "table",
                "link",
                "attachment"
              ]
            }
          },
          {
            "id": "fld_article_status",
            "key": "status",
            "label": "Status",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "allowed",
            "type": "choice",
            "settings": {
              "options": [
                {
                  "value": "draft",
                  "label": "Draft"
                },
                {
                  "value": "review",
                  "label": "In review"
                },
                {
                  "value": "published",
                  "label": "Published"
                },
                {
                  "value": "retired",
                  "label": "Retired"
                }
              ]
            },
            "default": "draft"
          },
          {
            "id": "fld_article_public",
            "key": "public",
            "label": "Public",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "allowed",
            "type": "yes_no",
            "settings": {},
            "default": false
          },
          {
            "id": "fld_article_review",
            "key": "review_date",
            "label": "Review date",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "allowed",
            "type": "date",
            "settings": {}
          },
          {
            "id": "fld_article_author",
            "key": "author",
            "label": "Author",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": false,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "allowed",
            "type": "link_to_person",
            "settings": {
              "audience": "application_accounts",
              "application_root_required": true,
              "on_person_deactivation": "retain_reference"
            }
          },
          {
            "id": "fld_article_files",
            "key": "attachments",
            "label": "Attachments",
            "required": false,
            "unique": false,
            "filterable": false,
            "sortable": false,
            "personal_data": "none",
            "public_display": "allowed",
            "type": "attachment",
            "settings": {
              "allowed_kinds": [
                "image",
                "document",
                "spreadsheet",
                "presentation",
                "audio",
                "video",
                "archive",
                "text",
                "other"
              ],
              "max_file_size_mb": 25,
              "multiple": true,
              "max_files": 10
            }
          }
        ],
        "relationships": []
      },
      {
        "id": "rt_sd_article_case",
        "key": "article_case",
        "name": "Article case link",
        "plural_name": "Article case links",
        "title_field": "linked_at",
        "storage_contract_id": "srt_00000014",
        "storage_scope": "application_contained",
