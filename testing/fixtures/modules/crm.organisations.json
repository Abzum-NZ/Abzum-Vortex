            "unique": false,
            "filterable": false,
            "sortable": false,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "allowed_schemes": [
                "https"
              ]
            }
          },
          {
            "id": "fld_company_phone",
            "key": "phone",
            "type": "phone_number",
            "label": "Main phone",
            "required": false,
            "unique": false,
            "filterable": false,
            "sortable": false,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "allowed",
