            "label": "Employee count",
            "required": false,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "minimum": 0
            }
          },
          {
            "id": "fld_company_website",
