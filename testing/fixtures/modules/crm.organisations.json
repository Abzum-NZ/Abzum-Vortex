          },
          {
            "id": "fld_company_logo",
            "key": "logo",
            "type": "attachment",
            "label": "Logo",
            "required": false,
            "unique": false,
            "filterable": false,
            "sortable": false,
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "allowed_kinds": [
                "image"
              ],
              "max_file_size_mb": 5,
              "multiple": false
            }
          },
          {
            "id": "fld_company_created",
            "key": "customer_since",
            "type": "date",
            "label": "Customer since",
            "required": false,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {}
          }
        ]
      }
    ],
    "permissions": [
      {
        "key": "vortex.crm.organisations.company.merge",
        "record_type": "company",
        "label": "Merge duplicate companies"
      }
    ],
    "actions": [
      {
        "id": "act_company_merge",
        "key": "vortex.crm.organisations.company.merge",
        "label": "Merge company",
        "record_type": "company",
        "permission": "vortex.crm.organisations.company.merge",
        "inputs": [
          {
            "key": "duplicate_company",
            "type": "link",
            "required": true,
            "settings": {
              "target": "vortex.crm.organisations:company"
            }
          }
        ],
        "effects": [
          {"kind":"copy_relationships","relationships":["parent_company"],"target_input":"duplicate_company"},
          {"kind":"soft_delete_subject"},
          {"kind":"announce_event","event":"vortex.crm.organisations.company.merged"}
        ],
        "shareable": false
      }
    ],
    "events": [
      {
        "id": "evt_company_created",
        "key": "vortex.crm.organisations.company.created",
        "record_type": "company",
        "carries": [
          "company_number",
          "name",
          "company_kind"
        ]
      },
      {
        "id": "evt_company_merged",
        "key": "vortex.crm.organisations.company.merged",
        "record_type": "company",
        "carries": [
          "company_number"
        ]
      }
    ],
    "rules": [
      {
        "id": "rule_company_name",
        "key": "company_name_required",
        "record_type": "company",
        "trigger": "change",
        "priority": 100,
        "condition": {
          "field": "name",
          "operator": "is_empty"
        },
        "effect": {"kind":"refuse","reason_code":"company_name_required"}
      }
    ],
    "extension_points": [
