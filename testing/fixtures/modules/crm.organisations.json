{
  "source_contract_version": "1.0.0",
  "kind": "module",
  "root_alias": "mod_crm_organisations",
  "key": "vortex.crm.organisations",
  "body": {
    "name": "CRM Organisations",
    "description": "Companies and their organisational details, shared by compatible applications in one organisation.",
    "dependencies": [],
    "record_types": [
      {
        "id": "rt_crm_company",
        "storage_contract_id": "srt_00000001",
        "key": "company",
        "name": "Company",
        "plural_name": "Companies",
        "storage_scope": "organisation_shared",
        "ownership_mode": "team",
        "title_field": "name",
        "standard_actions": [
          "create",
          "read",
          "update",
          "soft_delete",
          "restore",
          "export"
        ],
        "fields": [
          {
            "id": "fld_company_number",
            "key": "company_number",
            "type": "reference_number",
            "label": "Company number",
            "required": true,
            "unique": true,
            "filterable": true,
            "sortable": true,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "prefix": "COM-",
              "digits": 7
            }
          },
          {
            "id": "fld_company_name",
            "key": "name",
            "type": "text",
            "label": "Company name",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "first",
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "max_length": 255
            }
          },
          {
            "id": "fld_company_kind",
            "key": "company_kind",
            "type": "several_choices",
            "label": "Company type",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": false,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "options": [
                {
                  "value": "customer",
                  "label": "Customer"
                },
                {
                  "value": "prospect",
                  "label": "Prospect"
                },
                {
                  "value": "partner",
                  "label": "Partner"
                },
                {
                  "value": "supplier",
                  "label": "Supplier"
                }
              ]
            }
          },
          {
            "id": "fld_company_industry",
            "key": "industry",
            "type": "choice",
            "label": "Industry",
            "required": false,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "options": [
                {
                  "value": "technology",
                  "label": "Technology"
                },
                {
                  "value": "financial_services",
                  "label": "Financial services"
                },
                {
                  "value": "healthcare",
                  "label": "Healthcare"
                },
                {
                  "value": "manufacturing",
                  "label": "Manufacturing"
                },
                {
                  "value": "retail",
                  "label": "Retail"
                },
                {
                  "value": "other",
                  "label": "Other"
                }
              ]
            }
          },
          {
            "id": "fld_company_revenue",
            "key": "annual_revenue",
            "type": "money",
            "label": "Annual revenue",
            "required": false,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "currency_mode": "organisation_default",
              "minimum": 0
            }
          },
          {
            "id": "fld_company_employees",
            "key": "employee_count",
            "type": "whole_number",
            "label": "Employee count",
            "required": false,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "minimum": 0
            }
          },
          {
            "id": "fld_company_website",
            "key": "website",
            "type": "web_address",
            "label": "Website",
            "required": false,
            "unique": false,
            "filterable": false,
            "sortable": false,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "allowed_schemes": [
                "https"
              ]
            }
          },
          {
            "id": "fld_company_phone",
            "key": "phone",
            "type": "phone_number",
            "label": "Main phone",
            "required": false,
            "unique": false,
            "filterable": false,
            "sortable": false,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "default_country": "NZ"
            }
          },
          {
            "id": "fld_company_description",
            "key": "description",
            "type": "formatted_text",
            "label": "Description",
            "required": false,
            "unique": false,
            "filterable": false,
            "sortable": false,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "allowed_blocks": [
                "paragraph",
                "heading",
                "list",
                "link"
              ]
            }
          },
          {
            "id": "fld_company_parent",
            "key": "parent_company",
            "type": "link",
            "label": "Parent company",
            "required": false,
            "unique": false,
            "filterable": true,
            "sortable": false,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "target": "vortex.crm.organisations:company",
              "reverse_key": "subsidiaries",
              "on_parent_delete": "empty_optional"
            }
          },
          {
            "id": "fld_company_logo",
            "key": "logo",
            "type": "attachment",
            "label": "Logo",
            "required": false,
            "unique": false,
            "filterable": false,
            "sortable": false,
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "allowed_kinds": [
                "image"
              ],
              "max_file_size_mb": 5,
              "multiple": false
            }
          },
          {
            "id": "fld_company_created",
            "key": "customer_since",
            "type": "date",
            "label": "Customer since",
            "required": false,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {}
          }
        ],
        "custom_actions": [
          "act_company_merge"
        ],
        "relationships": [
          {
            "id": "fld_company_parent_relationship",
            "key": "parent_company",
            "from_field": "parent_company",
            "to_record_type": "vortex.crm.organisations:company",
            "cardinality": "many_to_one",
            "on_parent_delete": "empty_optional"
          }
        ]
      }
    ],
    "permissions": [
      {
        "id": "perm_company_create",
        "key": "vortex.crm.organisations.company.create",
        "label": "Create company",
        "description": "Allows the standard create operation for companies.",
        "record_type": "company",
        "action_kind": "create",
        "administrative": false
      },
      {
        "id": "perm_company_read",
        "key": "vortex.crm.organisations.company.read",
        "label": "Read company",
        "description": "Allows the standard read operation for companies.",
        "record_type": "company",
        "action_kind": "read",
        "administrative": false
      },
      {
        "id": "perm_company_update",
        "key": "vortex.crm.organisations.company.update",
        "label": "Update company",
        "description": "Allows the standard update operation for companies.",
        "record_type": "company",
        "action_kind": "update",
        "administrative": false
      },
      {
        "id": "perm_company_soft_delete",
        "key": "vortex.crm.organisations.company.soft_delete",
        "label": "Soft Delete company",
        "description": "Allows the standard soft_delete operation for companies.",
        "record_type": "company",
        "action_kind": "delete",
        "administrative": false
      },
      {
        "id": "perm_company_restore",
        "key": "vortex.crm.organisations.company.restore",
        "label": "Restore company",
        "description": "Allows the standard restore operation for companies.",
        "record_type": "company",
        "action_kind": "restore",
        "administrative": false
      },
      {
        "id": "perm_company_export",
        "key": "vortex.crm.organisations.company.export",
        "label": "Export company",
        "description": "Allows the standard export operation for companies.",
        "record_type": "company",
        "action_kind": "export",
        "administrative": false
      },
      {
        "id": "perm_named_1_merge",
        "key": "vortex.crm.organisations.company.merge",
        "label": "Merge duplicate companies",
        "description": "Allows the named merge operation.",
        "record_type": "company",
        "action_kind": "named",
        "named_action": "merge",
        "administrative": false
      }
    ],
    "actions": [
      {
        "id": "act_company_merge",
        "key": "vortex.crm.organisations.company.merge",
        "label": "Merge company",
        "record_type": "company",
        "permission": "vortex.crm.organisations.company.merge",
        "inputs": [
          {
            "key": "duplicate_company",
            "label": "Duplicate Company",
            "required": true,
            "type": "record_reference",
            "record_types": [
              "vortex.crm.organisations:company"
            ]
          }
        ],
        "effects": [
          {
            "kind": "copy_relationships",
            "relationships": [
              "parent_company"
            ],
            "target_input": "duplicate_company"
          },
          {
            "kind": "soft_delete_subject"
          },
          {
            "kind": "announce_event",
            "event": "vortex.crm.organisations.company.merged"
          }
        ],
        "shareable": false
      }
    ],
    "events": [
      {
        "id": "evt_company_created",
        "key": "vortex.crm.organisations.company.created",
        "record_type": "company",
        "carries": [
          "company_number",
          "name",
          "company_kind"
        ],
        "personal_or_sensitive_values_allowed": false
      },
      {
        "id": "evt_company_merged",
        "key": "vortex.crm.organisations.company.merged",
        "record_type": "company",
        "carries": [
          "company_number"
        ],
        "personal_or_sensitive_values_allowed": false
      }
    ],
    "rules": [
      {
        "id": "rule_company_name",
        "key": "company_name_required",
        "record_type": "company",
        "trigger": "change",
        "priority": 100,
        "condition": {
          "field": "name",
          "operator": "is_empty"
        },
        "effect": {
          "kind": "refuse",
          "reason_code": "company_name_required"
        }
      }
    ],
    "extension_points": [
      {
        "id": "ext_company_fields",
        "key": "company_fields",
        "record_type": "company",
        "accepts": [
          "field"
        ]
      },
      {
        "id": "ext_company_actions",
        "key": "company_actions",
        "record_type": "company",
        "accepts": [
          "action"
        ]
      }
    ],
    "sharing_conditions": []
  }
}
