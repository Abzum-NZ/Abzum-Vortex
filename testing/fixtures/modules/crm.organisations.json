            "required": false,
            "unique": false,
            "filterable": false,
            "sortable": false,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "allowed_blocks": [
                "paragraph",
                "heading",
                "list",
                "link"
              ]
            }
          },
          {
            "id": "fld_company_parent",
            "key": "parent_company",
            "type": "link",
            "label": "Parent company",
            "required": false,
            "unique": false,
            "filterable": true,
            "sortable": false,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "target": "vortex.crm.organisations:company",
              "reverse_key": "subsidiaries",
              "on_parent_delete": "empty_optional"
