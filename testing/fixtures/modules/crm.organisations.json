  "content_fingerprint": "fixture:vortex.crm.organisations:1.0.0",
  "body": {
    "name": "CRM Organisations",
    "description": "Companies and their organisational details, shared by compatible applications in one organisation.",
    "category": "CRM",
    "dependencies": [],
    "record_types": [
      {
        "id": "rt_crm_company",
        "storage_contract_id": "srt_00000001",
        "key": "company",
        "name": "Company",
        "plural_name": "Companies",
        "description": "A customer, prospect, supplier or partner organisation.",
        "storage_scope": "organisation_shared",
        "ownership_mode": "team",
        "title_field": "name",
        "standard_actions": [
          "create",
          "read",
          "update",
          "soft_delete",
          "restore",
          "export"
        ],
        "fields": [
          {
            "id": "fld_company_number",
            "key": "company_number",
            "type": "reference_number",
            "label": "Company number",
            "required": true,
            "unique": true,
            "filterable": true,
            "sortable": true,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "prefix": "COM-",
              "digits": 7
            }
          },
          {
            "id": "fld_company_name",
            "key": "name",
            "type": "text",
            "label": "Company name",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "first",
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "max_length": 255
            }
          },
          {
            "id": "fld_company_kind",
            "key": "company_kind",
            "type": "several_choices",
            "label": "Company type",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": false,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "options": [
                {
                  "value": "customer",
                  "label": "Customer"
                },
                {
                  "value": "prospect",
                  "label": "Prospect"
                },
                {
                  "value": "partner",
                  "label": "Partner"
                },
                {
                  "value": "supplier",
                  "label": "Supplier"
                }
              ]
            }
          },
          {
            "id": "fld_company_industry",
            "key": "industry",
            "type": "choice",
            "label": "Industry",
            "required": false,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "search_priority": "normal",
            "personal_data": "none",
            "public_display": "allowed",
            "settings": {
              "options": [
                {
                  "value": "technology",
                  "label": "Technology"
                },
                {
                  "value": "financial_services",
                  "label": "Financial services"
                },
                {
                  "value": "healthcare",
                  "label": "Healthcare"
                },
                {
                  "value": "manufacturing",
                  "label": "Manufacturing"
                },
                {
                  "value": "retail",
                  "label": "Retail"
                },
                {
                  "value": "other",
                  "label": "Other"
                }
              ]
            }
          },
          {
            "id": "fld_company_revenue",
            "key": "annual_revenue",
            "type": "money",
            "label": "Annual revenue",
            "required": false,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "settings": {
              "currency_mode": "organisation_default",
              "minimum": 0
            }
          },
          {
            "id": "fld_company_employees",
