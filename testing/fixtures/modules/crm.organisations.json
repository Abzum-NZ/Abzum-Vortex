        "id": "ext_company_fields",
        "key": "company_fields",
        "record_type": "company",
        "accepts": [
          "field"
        ]
      },
      {
        "id": "ext_company_actions",
        "key": "company_actions",
        "record_type": "company",
        "accepts": [
          "action"
        ]
      }
    ]
