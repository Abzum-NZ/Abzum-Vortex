{
  "kind": "module",
  "key": "vortex.crm",
  "version": "1.0.0",
  "name": "CRM",
  "description": "Accounts, contacts, leads, deals and activities. The worked example of Appendix A.",
  "state": "published",
  "revision": 1,
  "published_by": "acct_0000000000000000",
  "published_at": "2026-08-26T00:00:00Z",
  "note": "First published revision, written from Appendix A.",
  "body": {
    "icon": "briefcase",
    "category": "Sales",
    "publisher": "Abzum",
    "supplied_by": "publisher",
    "can_be_turned_off": true,
    "min_platform_version": "1.0.0",
    "data_sharing": ["application"],

    "record_types": [
      {
        "key": "account",
        "display_name": "Account",
        "display_name_plural": "Accounts",
        "description": "A company the organisation sells to.",
        "title_field": "name",
        "visibility": "everyone",
        "allow_inbound_delete": false,
        "fields": [
          {
            "key": "account_number",
            "type": "reference_number",
            "label": "Account number",
            "personal_data": "none",
            "unique": true,
            "settings": { "prefix": "ACC-", "digits": 6 }
          },
          {
            "key": "name",
            "type": "text",
            "label": "Company name",
            "required": true,
            "filterable": true,
            "sortable": true,
            "search": "first",
            "personal_data": "none",
            "settings": { "max_length": 255 }
          },
          {
            "key": "industry",
            "type": "choice",
            "label": "Industry",
            "filterable": true,
            "personal_data": "none",
            "settings": {
              "options": [
                { "value": "technology", "label": "Technology", "colour": "#3B6FD4" },
                { "value": "financial_services", "label": "Financial Services", "colour": "#1E7A5E" },
                { "value": "healthcare", "label": "Healthcare", "colour": "#B23A6B" },
                { "value": "manufacturing", "label": "Manufacturing", "colour": "#8A5714" },
                { "value": "retail", "label": "Retail", "colour": "#6B4FA8" }
              ]
            }
          },
          {
            "key": "annual_revenue",
            "type": "money",
            "label": "Annual revenue",
            "filterable": true,
            "sortable": true,
            "personal_data": "none"
          },
          {
            "key": "website",
            "type": "web_address",
            "label": "Website",
            "personal_data": "none"
          },
          {
            "key": "phone",
            "type": "phone_number",
            "label": "Phone",
            "personal_data": "none",
            "settings": { "default_country": "NZ" }
          },
          {
            "key": "total_won_revenue",
            "type": "total",
            "label": "Total won revenue",
            "personal_data": "none",
            "settings": {
              "relationship": "deals",
              "operation": "sum",
              "field": "amount",
              "filter": {
                "join": "and",
                "tests": [
                  { "left": { "source": "field", "name": "stage" }, "operator": "is", "right": "closed_won" }
                ]
              }
            }
          }
        ]
      },

      {
        "key": "contact",
        "display_name": "Contact",
        "display_name_plural": "Contacts",
        "description": "A person at a company.",
        "title_field": "full_name",
        "visibility": "everyone",
        "allow_inbound_delete": true,
        "fields": [
          {
            "key": "first_name",
            "type": "text",
            "label": "First name",
            "required": true,
            "personal_data": "personal",
            "settings": { "max_length": 80 }
          },
          {
            "key": "last_name",
            "type": "text",
            "label": "Last name",
            "required": true,
            "personal_data": "personal",
            "settings": { "max_length": 80 }
          },
          {
            "key": "full_name",
            "type": "calculation",
            "label": "Full name",
            "personal_data": "personal",
            "settings": {
              "result_type": "text",
              "expression": {
                "operation": "join_text",
                "parts": [
                  { "source": "field", "name": "first_name" },
                  { "source": "literal", "value": " " },
                  { "source": "field", "name": "last_name" }
                ]
              }
            }
          },
          {
            "key": "email",
            "type": "email_address",
            "label": "Email",
            "required": true,
            "unique": true,
            "search": "first",
            "personal_data": "personal"
          },
          {
            "key": "phone",
            "type": "phone_number",
            "label": "Phone",
            "personal_data": "personal",
            "settings": { "default_country": "NZ" }
          },
          {
            "key": "job_title",
            "type": "text",
            "label": "Job title",
            "personal_data": "none",
            "settings": { "max_length": 120 }
          },
          {
            "key": "account",
            "type": "link",
            "label": "Account",
            "required": true,
            "personal_data": "none",
            "settings": {
              "record_type": "account",
              "on_parent_delete": "delete_children",
              "reverse_label": "Contacts",
              "reverse_key": "contacts"
            }
          }
        ]
      },

      {
        "key": "lead",
        "display_name": "Lead",
        "display_name_plural": "Leads",
        "description": "An unqualified enquiry, before it becomes a deal.",
        "title_field": "company_name",
        "visibility": "owner",
        "allow_inbound_delete": true,
        "fields": [
          {
            "key": "lead_number",
            "type": "reference_number",
            "label": "Lead number",
            "personal_data": "none",
            "unique": true,
            "settings": { "prefix": "LEA-", "digits": 6 }
          },
          {
            "key": "first_name",
            "type": "text",
            "label": "First name",
            "required": true,
            "personal_data": "personal",
            "settings": { "max_length": 80 }
          },
          {
            "key": "last_name",
            "type": "text",
            "label": "Last name",
            "required": true,
            "search": "first",
            "personal_data": "personal",
            "settings": { "max_length": 80 }
          },
          {
            "key": "company_name",
            "type": "text",
            "label": "Company name",
            "required": true,
            "filterable": true,
            "search": "normal",
            "personal_data": "none",
            "settings": { "max_length": 255 }
          },
          {
            "key": "email",
            "type": "email_address",
            "label": "Email",
            "required": true,
            "personal_data": "personal"
          },
          {
            "key": "estimated_budget",
            "type": "money",
            "label": "Estimated budget",
            "filterable": true,
            "personal_data": "none"
          },
          {
            "key": "status",
            "type": "choice",
            "label": "Status",
            "filterable": true,
            "personal_data": "none",
            "default": "new",
            "settings": {
              "options": [
                { "value": "new", "label": "New" },
                { "value": "contacted", "label": "Contacted" },
                { "value": "qualified", "label": "Qualified" },
                { "value": "unqualified", "label": "Unqualified" },
                { "value": "converted", "label": "Converted" }
              ]
            }
          },
          {
            "key": "lead_score",
            "type": "whole_number",
            "label": "Lead score",
            "personal_data": "none",
            "default": 0,
            "settings": { "minimum": 0, "maximum": 100 }
          },
          {
            "key": "unqualified_reason",
            "type": "long_text",
            "label": "Unqualified reason",
            "personal_data": "none",
            "settings": { "max_length": 500 }
          }
        ]
      },

      {
        "key": "deal",
        "display_name": "Deal",
        "display_name_plural": "Deals",
        "description": "An opportunity being worked, with an amount and a close date.",
        "title_field": "name",
        "visibility": "everyone",
        "allow_inbound_delete": false,
        "fields": [
          {
            "key": "deal_number",
            "type": "reference_number",
            "label": "Deal number",
            "personal_data": "none",
            "unique": true,
            "settings": { "prefix": "OPP-", "digits": 6 }
          },
          {
            "key": "name",
            "type": "text",
            "label": "Deal name",
            "required": true,
            "search": "first",
            "personal_data": "none",
            "settings": { "max_length": 255 }
          },
          {
            "key": "amount",
            "type": "money",
            "label": "Amount",
            "required": true,
            "filterable": true,
            "sortable": true,
            "personal_data": "none"
          },
          {
            "key": "discount",
            "type": "whole_number",
            "label": "Discount",
            "personal_data": "none",
            "default": 0,
            "settings": { "minimum": 0, "maximum": 100 }
          },
          {
            "key": "net_amount",
            "type": "calculation",
            "label": "Net amount",
            "personal_data": "none",
            "settings": {
              "result_type": "money",
              "expression": {
                "operation": "multiply",
                "parts": [
                  { "source": "field", "name": "amount" },
                  {
                    "operation": "subtract",
                    "parts": [
                      { "source": "literal", "value": 1 },
                      {
                        "operation": "divide",
                        "parts": [
                          { "source": "field", "name": "discount" },
                          { "source": "literal", "value": 100 }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          {
            "key": "stage",
            "type": "choice",
            "label": "Stage",
            "filterable": true,
            "personal_data": "none",
            "default": "discovery",
            "settings": {
              "options": [
                { "value": "discovery", "label": "Discovery", "colour": "#5C6862" },
                { "value": "proposal", "label": "Proposal", "colour": "#3B6FD4" },
                { "value": "negotiation", "label": "Negotiation", "colour": "#8A5714" },
                { "value": "closed_won", "label": "Closed Won", "colour": "#1E7A5E", "permission": "vortex.crm.deal.mark_won" },
                { "value": "closed_lost", "label": "Closed Lost", "colour": "#B23A3A" }
              ]
            }
          },
          {
            "key": "close_date",
            "type": "date",
            "label": "Close date",
            "required": true,
            "filterable": true,
            "sortable": true,
            "personal_data": "none"
          },
          {
            "key": "payment_schedule",
            "type": "table",
            "label": "Payment schedule",
            "personal_data": "none",
            "settings": {
              "fewest_rows": 1,
              "most_rows": 12,
              "columns": [
                { "key": "milestone", "label": "Milestone", "type": "text", "required": true, "max_length": 120 },
                { "key": "percentage", "label": "Percentage of the deal", "type": "whole_number", "required": true, "minimum": 0, "maximum": 100 },
                { "key": "amount_due", "label": "Amount due", "type": "money", "required": true },
                { "key": "target_date", "label": "Target date", "type": "date", "required": true },
                { "key": "paid", "label": "Paid", "type": "yes_no", "default": false }
              ]
            }
          },
          {
            "key": "account",
            "type": "link",
            "label": "Account",
            "required": true,
            "personal_data": "none",
            "settings": {
              "record_type": "account",
              "on_parent_delete": "refuse",
              "reverse_label": "Deals",
              "reverse_key": "deals"
            }
          },
          {
            "key": "primary_contact",
            "type": "link",
            "label": "Primary contact",
            "personal_data": "none",
            "settings": {
              "record_type": "contact",
              "on_parent_delete": "empty_the_link",
              "reverse_label": "Deals as primary contact",
              "reverse_key": "deals_as_primary_contact"
            }
          }
        ],
        "relationships": [
          {
            "key": "contacts_involved",
            "label": "Contacts involved",
            "record_type": "contact",
            "reverse_label": "Deals involved in"
          }
        ]
      },

      {
        "key": "activity",
        "display_name": "Activity",
        "display_name_plural": "Activities",
        "description": "A call, meeting, email or task, recorded against any of the above.",
        "title_field": "subject",
        "visibility": "everyone",
        "allow_inbound_delete": true,
        "fields": [
          {
            "key": "subject",
            "type": "text",
            "label": "Subject",
            "required": true,
            "search": "first",
            "personal_data": "none",
            "settings": { "max_length": 255 }
          },
          {
            "key": "activity_type",
            "type": "choice",
            "label": "Activity type",
            "filterable": true,
            "personal_data": "none",
            "settings": {
              "options": [
                { "value": "phone_call", "label": "Phone call", "icon": "phone" },
                { "value": "meeting", "label": "Meeting", "icon": "calendar" },
                { "value": "email", "label": "Email", "icon": "envelope" },
                { "value": "to_do", "label": "To-do", "icon": "check-square" }
              ]
            }
          },
          {
            "key": "due_date",
            "type": "date_time",
            "label": "Due date",
            "required": true,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "settings": { "shown_in": "reader" }
          },
          {
            "key": "completed",
            "type": "yes_no",
            "label": "Completed",
            "filterable": true,
            "personal_data": "none",
            "default": false
          },
          {
            "key": "regarding",
            "type": "link_to_one_of_several",
            "label": "Regarding",
            "personal_data": "none",
            "settings": {
              "record_types": ["account", "contact", "lead", "deal"]
            }
          }
        ]
      }
    ],

    "permissions": [
      {
        "key": "vortex.crm.lead.convert",
        "record_type": "lead",
        "label": "Convert a lead into an account, a contact and a deal"
      },
      {
        "key": "vortex.crm.deal.approve_discount",
        "record_type": "deal",
        "label": "Approve a discount over 15 per cent"
      },
      {
        "key": "vortex.crm.deal.mark_won",
        "record_type": "deal",
        "label": "Mark a deal as won"
      }
    ],

    "rules": [
      {
        "id": "vortex.crm.lead.reason_required_when_unqualified",
        "label": "A reason is required when a lead is marked unqualified",
        "record_type": "lead",
        "moment": "saving",
        "watches": ["status", "unqualified_reason"],
        "condition": {
          "join": "and",
          "tests": [
            { "left": { "source": "field", "name": "status" }, "operator": "is", "right": "unqualified" },
            { "left": { "source": "field", "name": "unqualified_reason" }, "operator": "is_empty" }
          ]
        },
        "effect": "refuse",
        "field": "unqualified_reason",
        "message": "Say why this lead is unqualified before saving.",
        "priority": 500,
        "origin": "module"
      },
      {
        "id": "vortex.crm.deal.large_discount_needs_approval",
        "label": "Large discounts need approval",
        "record_type": "deal",
        "moment": "saving",
        "watches": ["discount"],
        "condition": {
          "join": "and",
          "tests": [
            { "left": { "source": "field", "name": "discount" }, "operator": "is_more_than", "right": 15 },
            { "left": { "source": "permission", "name": "vortex.crm.deal.approve_discount" }, "operator": "is", "right": false }
          ]
        },
        "effect": "refuse",
        "field": "discount",
        "message": "A discount over 15 per cent needs approval. Ask a sales manager to save this.",
        "priority": 500,
        "origin": "module"
      }
    ],

    "events": [
      {
        "id": "vortex.crm.account.created",
        "label": "Account created",
        "record_type": "account",
        "carries": [
          { "name": "account", "source": "field", "field": "account_number" },
          { "name": "name", "source": "field", "field": "name" },
          { "name": "industry", "source": "field", "field": "industry" }
        ]
      },
      {
        "id": "vortex.crm.deal.stage_changed",
        "label": "Deal stage changed",
        "record_type": "deal",
        "carries": [
          { "name": "deal", "source": "field", "field": "deal_number" },
          { "name": "account", "source": "linked_record", "field": "account" },
          { "name": "old_stage", "source": "previous", "field": "stage" },
          { "name": "new_stage", "source": "field", "field": "stage" },
          { "name": "amount", "source": "field", "field": "amount" }
        ]
      },
      {
        "id": "vortex.crm.lead.converted",
        "label": "Lead converted",
        "record_type": "lead",
        "carries": [
          { "name": "lead", "source": "field", "field": "lead_number" },
          { "name": "account", "source": "linked_record", "field": "account" },
          { "name": "contact", "source": "linked_record", "field": "contact" },
          { "name": "deal", "source": "linked_record", "field": "deal" }
        ]
      }
    ],

    "extension_points": [
      {
        "key": "account_fields",
        "label": "Fields on an account",
        "record_type": "account",
        "accepts": ["field"]
      },
      {
        "key": "deal_fields",
        "label": "Fields on a deal",
        "record_type": "deal",
        "accepts": ["field"]
      }
    ]
  }
}
