{
  "kind": "application",
  "key": "app.sales_hub",
  "version": "1.0.0",
  "name": "Enterprise Sales Hub CRM",
  "description": "One workspace for lead qualification, pipeline forecasting and the customer record.",
  "state": "published",
  "revision": 1,
  "published_by": "acct_0000000000000000",
  "published_at": "2026-08-26T00:00:00Z",
  "note": "First published revision, written from Appendix B.",
  "body": {
    "name": "Enterprise Sales Hub CRM",
    "description": "One workspace for lead qualification, pipeline forecasting and the customer record.",
    "icon": "trending-up",
    "category": "Sales",
    "publisher": "Abzum",
    "home_page": "executive_dashboard",
    "currency": "USD",
    "financial_year_start_month": 4,

    "modules": [
      {
        "module": "vortex.crm",
        "sharing": "used_only_by_this_application",
        "version": "1.0.0"
      }
    ],

    "options": [
      {
        "id": "discount_override",
        "label": "Discount override",
        "help": "Turning it off removes the approval path for discounts over 15 per cent.",
        "default": true
      },
      {
        "id": "public_enquiry_form",
        "label": "Public enquiry form",
        "help": "Turning it off takes the public enquiry page off the menu and closes it.",
        "default": true
      },
      {
        "id": "in_app_assistant",
        "label": "In-app assistant",
        "help": "Turning it off removes the assistant from every page.",
        "default": true
      }
    ],

    "app_permissions": [
      { "id": "export_forecast", "label": "Export the forecast" }
    ],

    "app_roles": [
      {
        "id": "sales_representative",
        "name": "Sales representative",
        "description": "Works the pipeline, qualifies leads and keeps the customer record current.",
        "home_page": "deals_pipeline",
        "permissions": [
          "vortex.crm.account.read",
          "vortex.crm.account.create",
          "vortex.crm.account.update",
          "vortex.crm.contact.read",
          "vortex.crm.contact.create",
          "vortex.crm.contact.update",
          "vortex.crm.lead.read",
          "vortex.crm.lead.create",
          "vortex.crm.lead.update",
          "vortex.crm.deal.read",
          "vortex.crm.deal.create",
          "vortex.crm.deal.update",
          "vortex.crm.activity.read",
          "vortex.crm.activity.create",
          "vortex.crm.activity.update",
          "vortex.crm.lead.convert"
        ]
      },
      {
        "id": "sales_manager",
        "name": "Sales manager",
        "description": "Everything in the customer records, plus discount approval and the forecast.",
        "home_page": "executive_dashboard",
        "permissions": [
          "vortex.crm.account.read",
          "vortex.crm.account.create",
          "vortex.crm.account.update",
          "vortex.crm.account.delete",
          "vortex.crm.contact.read",
          "vortex.crm.contact.create",
          "vortex.crm.contact.update",
          "vortex.crm.contact.delete",
          "vortex.crm.lead.read",
          "vortex.crm.lead.create",
          "vortex.crm.lead.update",
          "vortex.crm.lead.delete",
          "vortex.crm.deal.read",
          "vortex.crm.deal.create",
          "vortex.crm.deal.update",
          "vortex.crm.deal.delete",
          "vortex.crm.activity.read",
          "vortex.crm.activity.create",
          "vortex.crm.activity.update",
          "vortex.crm.activity.delete",
          "vortex.crm.lead.convert",
          "vortex.crm.deal.approve_discount",
          "vortex.crm.deal.mark_won",
          "export_forecast"
        ]
      }
    ],

    "navigation": {
      "sections": [
        {
          "id": "sales_workspace",
          "label": "Sales workspace",
          "icon": "briefcase",
          "groups": [
            {
              "id": "pipeline_and_revenue",
              "label": "Pipeline and revenue",
              "entries": [
                { "id": "nav_executive_dashboard", "label": "Executive dashboard", "icon": "layout-dashboard", "page": "executive_dashboard" },
                { "id": "nav_deals_pipeline", "label": "Deals pipeline", "icon": "columns", "page": "deals_pipeline" },
                { "id": "nav_leads", "label": "Leads", "icon": "user-plus", "page": "leads" }
              ]
            },
            {
              "id": "customer_directory",
              "label": "Customer directory",
              "entries": [
                { "id": "nav_accounts", "label": "Accounts", "icon": "building", "page": "accounts" },
                { "id": "nav_contacts", "label": "Contacts", "icon": "users", "page": "contacts" }
              ]
            },
            {
              "id": "work_and_activities",
              "label": "Work and activities",
              "entries": [
                { "id": "nav_my_open_tasks", "label": "My open tasks", "icon": "check-square", "page": "my_open_tasks" }
              ]
            }
          ]
        },
        {
          "id": "public_forms",
          "label": "Public forms",
          "icon": "globe",
          "groups": [
            {
              "id": "inbound_enquiries",
              "label": "Inbound enquiries",
              "entries": [
                {
                  "id": "nav_enquire_with_sales",
                  "label": "Enquire with sales",
                  "icon": "mail",
                  "page": "enquire_with_sales",
                  "requires_option": "public_enquiry_form"
                }
              ]
            }
          ]
        }
      ]
    },

    "pages": [
      {
        "id": "executive_dashboard",
        "name": "Executive dashboard",
        "type": "dashboard",
        "opened_by": "anyone_signed_in",
        "in_menu": true,
        "blocks": [
          { "id": "revenue_won_this_year", "block": "figure", "settings": { "record_type": "vortex.crm:deal", "operation": "sum", "field": "amount" } },
          { "id": "pipeline_by_stage", "block": "bar_chart", "settings": { "record_type": "vortex.crm:deal", "group_by": "stage", "operation": "sum", "field": "amount" } },
          { "id": "open_deals_over_fifty_thousand", "block": "table", "settings": { "record_type": "vortex.crm:deal", "fields": ["name", "account", "amount", "stage", "close_date"] } }
        ]
      },
      {
        "id": "deals_pipeline",
        "name": "Deals pipeline",
        "type": "list",
        "subject": "vortex.crm:deal",
        "opened_by": "vortex.crm.deal.read",
        "in_menu": true,
        "empty_message": "No deals yet. Create one, or convert a lead.",
        "blocks": [
          { "id": "pipeline_board", "block": "board", "settings": { "record_type": "vortex.crm:deal", "group_by": "stage", "inline_edit": true } }
        ]
      },
      {
        "id": "leads",
        "name": "Leads",
        "type": "list",
        "subject": "vortex.crm:lead",
        "opened_by": "vortex.crm.lead.read",
        "in_menu": true,
        "empty_message": "No leads yet.",
        "blocks": [
          { "id": "leads_table", "block": "table", "settings": { "record_type": "vortex.crm:lead", "fields": ["company_name", "last_name", "status", "estimated_budget", "lead_score"], "accepts_address_filter": true } }
        ]
      },
      {
        "id": "accounts",
        "name": "Accounts",
        "type": "list",
        "subject": "vortex.crm:account",
        "opened_by": "vortex.crm.account.read",
        "in_menu": true,
        "empty_message": "No accounts yet.",
        "blocks": [
          { "id": "accounts_table", "block": "table", "settings": { "record_type": "vortex.crm:account", "fields": ["name", "industry", "annual_revenue", "total_won_revenue"] } }
        ]
      },
      {
        "id": "contacts",
        "name": "Contacts",
        "type": "list",
        "subject": "vortex.crm:contact",
        "opened_by": "vortex.crm.contact.read",
        "in_menu": true,
        "empty_message": "No contacts yet.",
        "blocks": [
          { "id": "contacts_table", "block": "table", "settings": { "record_type": "vortex.crm:contact", "fields": ["full_name", "account", "email", "job_title"] } }
        ]
      },
      {
        "id": "my_open_tasks",
        "name": "My open tasks",
        "type": "list",
        "subject": "vortex.crm:activity",
        "opened_by": "vortex.crm.activity.read",
        "in_menu": true,
        "empty_message": "Nothing open. ",
        "blocks": [
          { "id": "my_tasks_table", "block": "table", "settings": { "record_type": "vortex.crm:activity", "fields": ["subject", "activity_type", "due_date", "completed"] } }
        ]
      },
      {
        "id": "enquire_with_sales",
        "name": "Enquire with sales",
        "type": "public",
        "subject": "vortex.crm:lead",
        "opened_by": "anyone",
        "in_menu": true,
        "requires_option": "public_enquiry_form",
        "commit_action": "vortex.crm.lead.create_from_enquiry",
        "blocks": [
          { "id": "enquiry_form", "block": "form", "settings": { "record_type": "vortex.crm:lead", "fields": ["company_name", "first_name", "last_name", "email", "estimated_budget"] } }
        ]
      },
      {
        "id": "convert_lead",
        "name": "Convert lead",
        "type": "guided_form",
        "subject": "vortex.crm:lead",
        "opened_by": "vortex.crm.lead.convert",
        "in_menu": false,
        "commit_action": "vortex.crm.lead.convert",
        "steps": [
          {
            "id": "confirm_the_contact_and_the_company",
            "label": "Confirm the contact and the company",
            "blocks": [
              { "id": "step_one_form", "block": "form", "settings": { "record_type": "vortex.crm:lead", "fields": ["company_name", "first_name", "last_name", "email", "estimated_budget"] } }
            ]
          },
          {
            "id": "enterprise_deal",
            "label": "Enterprise deal",
            "shown_when": {
              "join": "and",
              "tests": [
                { "left": { "source": "field", "name": "estimated_budget" }, "operator": "is_more_than", "right": 50000 }
              ]
            },
            "blocks": [
              { "id": "enterprise_form", "block": "form", "settings": { "record_type": "vortex.crm:deal", "fields": ["name", "amount", "discount", "payment_schedule"] } }
            ]
          },
          {
            "id": "standard_package",
            "label": "Standard package",
            "shown_when": {
              "join": "and",
              "negate": true,
              "tests": [
                { "left": { "source": "field", "name": "estimated_budget" }, "operator": "is_more_than", "right": 50000 }
              ]
            },
            "blocks": [
              { "id": "standard_form", "block": "form", "settings": { "record_type": "vortex.crm:deal", "fields": ["name", "amount", "close_date"] } }
            ]
          },
          {
            "id": "review_and_convert",
            "label": "Review and convert",
            "blocks": [
              { "id": "review_summary", "block": "summary", "settings": { "record_type": "vortex.crm:lead" } }
            ]
          }
        ]
      },
      {
        "id": "deal_detail",
        "name": "Deal detail",
        "type": "detail",
        "subject": "vortex.crm:deal",
        "opened_by": "vortex.crm.deal.read",
        "in_menu": false,
        "blocks": [
          { "id": "deal_fields", "block": "record_fields", "settings": { "record_type": "vortex.crm:deal" } },
          { "id": "deal_payment_schedule", "block": "record_table_field", "settings": { "record_type": "vortex.crm:deal", "field": "payment_schedule" } },
          { "id": "deal_activities", "block": "table", "settings": { "record_type": "vortex.crm:activity", "through": "regarding" } }
        ]
      }
    ],

    "process_pipelines": ["app.sales_hub.qualification"],
    "workflows": ["app.sales_hub.on_deal_won"],
    "connections": ["conn.slack", "conn.email_sending"],
    "search_scope": [
      "vortex.crm:account",
      "vortex.crm:contact",
      "vortex.crm:deal",
      "vortex.crm:lead"
    ],
    "assistant": {
      "enabled": true,
      "record_types": [
        "vortex.crm:account",
        "vortex.crm:contact",
        "vortex.crm:lead",
        "vortex.crm:deal"
      ],
      "purpose": "Helps with lead qualification, contact lookups, pipeline forecasting and drafting messages to customers."
    },
    "interface": "iface.sales_hub"
  }
}
