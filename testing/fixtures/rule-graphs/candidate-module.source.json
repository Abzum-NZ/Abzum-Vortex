{
  "source_contract_version": "3.0.0",
  "root_alias": "example_candidate",
  "key": "example.candidate",
  "kind": "module",
  "body": {
    "name": "example.candidate",
    "description": "Generic packaged rule lifecycle fixture.",
    "dependencies": [
      {
        "dependency_key": "shared",
        "module": "example.shared",
        "version": {
          "selection": "exact",
          "version": "1.0.0"
        }
      }
    ],
    "record_types": [
      {
        "id": "rt_candidate",
        "key": "candidate",
        "name": "candidate",
        "plural_name": "candidate records",
        "title_field": "name",
        "storage_contract_id": "storage_candidate",
        "storage_scope": "application_contained",
        "ownership_mode": "none",
        "standard_actions": ["create", "read", "update"],
        "custom_actions": [],
        "fields": [
          {
            "id": "fld_name",
            "key": "name",
            "label": "name",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "type": "text",
            "settings": {
              "max_length": 120
            }
          },
          {
            "id": "fld_amount",
            "key": "amount",
            "label": "amount",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "type": "decimal_number",
            "settings": {
              "digits_before_decimal": 30,
              "decimal_places": 4
            }
          },
          {
            "id": "fld_status",
            "key": "status",
            "label": "status",
            "required": true,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "type": "text",
            "settings": {
              "max_length": 40
            }
          },
          {
            "id": "fld_budget",
            "key": "budget",
            "label": "budget",
            "required": false,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "type": "money",
            "settings": {
              "currency_mode": "fixed",
              "currency": "NZD"
            }
          },
          {
            "id": "fld_obsolete_note",
            "key": "obsolete_note",
            "label": "obsolete note",
            "required": false,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "type": "text",
            "settings": {
              "max_length": 200
            }
          },
          {
            "id": "fld_related",
            "key": "related",
            "label": "related",
            "required": false,
            "unique": false,
            "filterable": true,
            "sortable": true,
            "personal_data": "none",
            "public_display": "refused",
            "type": "link",
            "settings": {
              "target": "example.shared:related",
              "reverse_key": "candidates",
              "on_parent_delete": "refuse"
            }
          }
        ],
        "relationships": []
      }
    ],
    "permissions": [],
    "actions": [],
    "events": [],
    "rules": [
      {
        "id": "prepare_candidate",
        "key": "prepare_candidate",
        "record_type": "candidate",
        "profile": "before_save",
        "graph_version": "1.0.0",
        "priority": 100,
        "inputs": [
          {
            "id": "minimum_amount",
            "key": "minimum_amount",
            "type": "decimal_number",
            "required": false
          },
          {
            "id": "requested_budget",
            "key": "requested_budget",
            "type": "money",
            "required": true
          },
          {
            "id": "related_record",
            "key": "related_record",
            "type": "link",
            "required": true,
            "record_types": ["example.shared:related"]
          }
        ],
        "variables": [
          {
            "id": "effective_budget",
            "key": "effective_budget",
            "type": "money",
            "default_value": {
              "type": "money",
              "value": {
                "amount": "12.3400",
                "currency": "NZD"
              }
            }
          },
          {
            "id": "remembered_record",
            "key": "remembered_record",
            "type": "link_to_one_of_several",
            "record_types": ["example.shared:related", "example.shared:alternative"],
            "default_value": {
              "type": "link_to_one_of_several",
              "value": {
                "record_type": "example.shared:related",
                "record_id": "80000000-0000-4000-8000-000000000001"
              }
            }
          }
        ],
        "nodes": [
          {
            "id": "start",
            "node_version": "1.0.0",
            "type": "start",
            "operations": ["update"]
          },
          {
            "id": "eligible",
            "node_version": "1.0.0",
            "type": "condition",
            "condition": {
              "kind": "all",
              "conditions": [
                {
                  "kind": "comparison",
                  "operator": "greater_than",
                  "left": {
                    "source": "current_field",
                    "field": "amount"
                  },
                  "right": {
                    "source": "literal",
                    "value": {
                      "type": "decimal_number",
                      "value": "9007199254740993.00"
                    }
                  }
                },
                {
                  "kind": "comparison",
                  "operator": "not_equals",
                  "left": {
                    "source": "previous_field",
                    "field": "status"
                  },
                  "right": {
                    "source": "current_field",
                    "field": "status"
                  }
                },
                {
                  "kind": "comparison",
                  "operator": "equals",
                  "left": {
                    "source": "input",
                    "input": "related_record"
                  },
                  "right": {
                    "source": "literal",
                    "value": {
                      "type": "link",
                      "value": {
                        "record_type": "example.shared:related",
                        "record_id": "80000000-0000-4000-8000-000000000001"
                      }
                    }
                  }
                }
              ]
            }
          },
          {
            "id": "remember_budget",
            "node_version": "1.0.0",
            "type": "set_variable",
            "variable": "effective_budget",
            "value": {
              "source": "input",
              "input": "requested_budget"
            }
          },
          {
            "id": "apply_budget",
            "node_version": "1.0.0",
            "type": "set_field",
            "field": "budget",
            "assignment": {
              "kind": "set",
              "value": {
                "source": "variable",
                "variable": "effective_budget"
              }
            }
          },
          {
            "id": "clear_obsolete_note",
            "node_version": "1.0.0",
            "type": "set_field",
            "field": "obsolete_note",
            "assignment": {
              "kind": "clear"
            }
          },
          {
            "id": "require_relation",
            "node_version": "1.0.0",
            "type": "require_field",
            "field": "related",
            "code": "related_required",
            "message": "Choose a related record."
          },
          {
            "id": "warn_adjustment",
            "node_version": "1.0.0",
            "type": "warn",
            "code": "budget_adjusted",
            "message": "The proposed budget was applied."
          },
          {
            "id": "refuse_amount",
            "node_version": "1.0.0",
            "type": "refuse",
            "code": "amount_too_low",
            "message": "The amount is below the allowed threshold.",
            "field": "amount"
          },
          {
            "id": "finish",
            "node_version": "1.0.0",
            "type": "finish"
          }
        ],
        "edges": [
          {
            "from": "start",
            "port": "next",
            "to": "eligible"
          },
          {
            "from": "eligible",
            "port": "true",
            "to": "remember_budget"
          },
          {
            "from": "eligible",
            "port": "false",
            "to": "refuse_amount"
          },
          {
            "from": "remember_budget",
            "port": "next",
            "to": "apply_budget"
          },
          {
            "from": "apply_budget",
            "port": "next",
            "to": "clear_obsolete_note"
          },
          {
            "from": "clear_obsolete_note",
            "port": "next",
            "to": "require_relation"
          },
          {
            "from": "require_relation",
            "port": "next",
            "to": "warn_adjustment"
          },
          {
            "from": "warn_adjustment",
            "port": "next",
            "to": "finish"
          }
        ]
      }
    ],
    "extension_points": [],
    "sharing_conditions": []
  }
}
