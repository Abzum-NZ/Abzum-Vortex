{
  "query_parameters": {
    "kind": "list",
    "key": "query_parameters",
    "label": "Query inputs",
    "help": "Where each input of the bound query takes its value from",
    "required": false,
    "minimumItems": 0,
    "maximumItems": 20,
    "item": {
      "kind": "group",
      "key": "binding",
      "label": "Input binding",
      "help": "One query input and the source of its value",
      "required": true,
      "properties": [
        {
          "kind": "text",
          "key": "input",
          "label": "Input",
          "help": "Key of the query input",
          "required": true,
          "minLength": 1,
          "maxLength": 60
        },
        {
          "kind": "choice",
          "key": "source",
          "label": "Source",
          "help": "Where the value comes from",
          "required": true,
          "options": [
            {
              "key": "fixed",
              "label": "Fixed value"
            },
            {
              "key": "page_parameter",
              "label": "Page parameter"
            },
            {
              "key": "record_field",
              "label": "Record field"
            },
            {
              "key": "current_person",
              "label": "Current person"
            },
            {
              "key": "control",
              "label": "Control on this page"
            },
            {
              "key": "relative_date",
              "label": "Relative date"
            },
            {
              "key": "this_row",
              "label": "This row"
            }
          ]
        },
        {
          "kind": "text",
          "key": "value",
          "label": "Value",
          "help": "The fixed value, written for the input's type",
          "required": true,
          "minLength": 0,
          "maxLength": 500,
          "showWhen": {
            "property": "source",
            "values": ["fixed"]
          }
        },
        {
          "kind": "text",
          "key": "name",
          "label": "Page parameter",
          "help": "A parameter this page declares",
          "required": true,
          "minLength": 1,
          "maxLength": 40,
          "showWhen": {
            "property": "source",
            "values": ["page_parameter"]
          }
        },
        {
          "kind": "field_reference",
          "key": "field",
          "label": "Field",
          "help": "A field of the page's record, or of the row for This row",
          "required": false,
          "showWhen": {
            "property": "source",
            "values": ["record_field", "this_row"]
          }
        },
        {
          "kind": "choice",
          "key": "part",
          "label": "Part",
          "help": "Which part of the person viewing the page",
          "required": true,
          "options": [
            {
              "key": "person",
              "label": "Person"
            }
          ],
          "showWhen": {
            "property": "source",
            "values": ["current_person"]
          }
        },
        {
          "kind": "text",
          "key": "control_placement",
          "label": "Control",
          "help": "A control on this page whose value is used",
          "required": true,
          "minLength": 1,
          "maxLength": 60,
          "showWhen": {
            "property": "source",
            "values": ["control"]
          }
        },
        {
          "kind": "choice",
          "key": "anchor",
          "label": "Date",
          "help": "The date the value counts from, in the organisation's time zone",
          "required": true,
          "options": [
            {
              "key": "today",
              "label": "Today"
            },
            {
              "key": "start_of_week",
              "label": "Start of this week"
            },
            {
              "key": "start_of_month",
              "label": "Start of this month"
            },
            {
              "key": "start_of_quarter",
              "label": "Start of this quarter"
            },
            {
              "key": "start_of_year",
              "label": "Start of this year"
            },
            {
              "key": "end_of_month",
              "label": "End of this month"
            }
          ],
          "showWhen": {
            "property": "source",
            "values": ["relative_date"]
          }
        },
        {
          "kind": "number",
          "key": "offset_days",
          "label": "Offset in days",
          "help": "Days added to the date; a negative number counts back",
          "required": true,
          "integer": true,
          "minimum": -3660,
          "maximum": 3660,
          "showWhen": {
            "property": "source",
            "values": ["relative_date"]
          }
        }
      ]
    }
  },
  "awaiting_message": {
    "kind": "text",
    "key": "awaiting_message",
    "presentation": true,
    "label": "Waiting message",
    "help": "Shown while a required input has no value yet; unset says which input to choose",
    "required": false,
    "minLength": 1,
    "maxLength": 200
  }
}
