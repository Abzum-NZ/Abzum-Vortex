      {
        "contractVersion": "1.0.0",
        "id": "rule_leave_request_dates",
        "key": "end_date_not_before_start_date",
        "execution": "transaction",
        "runAs": {
          "kind": "saver"
        },
        "triggers": [
          {
            "id": "before_save",
            "type": "BeforeSave",
            "recordTypeId": "leave_request",
            "operations": [
              {
                "kind": "create"
              },
              {
                "kind": "update"
              }
            ],
            "priority": 100
          }
        ],
        "tasks": [
          {
            "id": "both_dates_present",
            "type": "if",
            "condition": {
              "op": "and",
              "args": [
                {
                  "op": "not",
                  "arg": {
                    "op": "is_empty",
                    "arg": {
                      "op": "reference",
                      "reference": {
                        "source": "trigger_record",
                        "field": "start_date"
                      }
                    }
                  }
                },
                {
                  "op": "not",
                  "arg": {
                    "op": "is_empty",
                    "arg": {
                      "op": "reference",
                      "reference": {
                        "source": "trigger_record",
                        "field": "end_date"
                      }
                    }
                  }
                }
              ]
            },
            "then": [
              {
                "id": "end_before_start",
                "type": "if",
                "condition": {
                  "op": "lt",
                  "left": {
                    "op": "reference",
                    "reference": {
                      "source": "trigger_record",
                      "field": "end_date"
                    }
                  },
                  "right": {
                    "op": "reference",
                    "reference": {
                      "source": "trigger_record",
                      "field": "start_date"
                    }
                  }
                },
                "then": [
                  {
                    "id": "refuse_end_before_start",
                    "type": "rule.refuse",
                    "version": "1.0.0",
                    "properties": {
                      "reason": {
                        "kind": "literal",
                        "literal": {
                          "type": "text",
                          "value": "end_date_before_start_date"
                        }
                      },
                      "message": {
                        "kind": "literal",
                        "literal": {
                          "type": "text",
                          "value": "End date must be on or after the start date."
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "contractVersion": "1.0.0",
        "id": "rule_leave_entitlement_taken",
        "key": "taken_within_entitlement",
        "execution": "transaction",
        "runAs": {
          "kind": "saver"
        },
        "triggers": [
          {
            "id": "before_save",
            "type": "BeforeSave",
            "recordTypeId": "leave_entitlement",
            "operations": [
              {
                "kind": "create"
              },
              {
                "kind": "update"
              }
            ],
            "priority": 100
          }
        ],
        "tasks": [
          {
            "id": "taken_present",
            "type": "if",
            "condition": {
              "op": "and",
              "args": [
                {
                  "op": "not",
                  "arg": {
                    "op": "is_empty",
                    "arg": {
                      "op": "reference",
                      "reference": {
                        "source": "trigger_record",
                        "field": "approved_days_taken"
                      }
                    }
                  }
                },
                {
                  "op": "not",
                  "arg": {
                    "op": "is_empty",
                    "arg": {
                      "op": "reference",
                      "reference": {
                        "source": "trigger_record",
                        "field": "days"
                      }
                    }
                  }
                }
              ]
            },
            "then": [
              {
                "id": "taken_exceeds_entitlement",
                "type": "if",
                "condition": {
                  "op": "gt",
                  "left": {
                    "op": "reference",
                    "reference": {
                      "source": "trigger_record",
                      "field": "approved_days_taken"
                    }
                  },
                  "right": {
                    "op": "reference",
                    "reference": {
                      "source": "trigger_record",
                      "field": "days"
                    }
                  }
                },
                "then": [
                  {
                    "id": "refuse_taken_exceeds",
                    "type": "rule.refuse",
                    "version": "1.0.0",
                    "properties": {
                      "reason": {
                        "kind": "literal",
                        "literal": {
                          "type": "text",
                          "value": "leave_entitlement_exceeded"
                        }
                      },
                      "message": {
                        "kind": "literal",
                        "literal": {
                          "type": "text",
                          "value": "Taken days cannot exceed entitlement"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
