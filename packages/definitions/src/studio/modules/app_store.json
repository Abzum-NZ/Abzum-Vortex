{
  "id": "mod_app_store",
  "key": "vortex.app_store",
  "name": "App Store",
  "description": "Studio's App Store section: the organisation's application catalogue, a read-only system projection of every application it has. Installing, upgrading, removing and deleting are registered platform operations a flow calls, never record writes.",
  "record_types": [
    {
      "id": "rt_store_application",
      "key": "store_application",
      "name": "Application",
      "plural_name": "Applications",
      "title_field": "name",
      "storage_contract_id": "srt_app_store_store_application",
      "storage_scope": "organization_shared",
      "ownership_mode": "none",
      "standard_actions": ["read"],
      "custom_actions": [],
      "system_projection": {
        "protected_view": "application_store_entries",
        "organization_field": "organization_id",
        "revision_field": "revision",
        "filterable_fields": ["name", "status", "is_system_application"],
        "sortable_fields": ["key", "name", "status", "listing_order"],
        "refresh_while": {
          "field": "record_update_status",
          "values": ["pending", "updating", "retrying"],
          "interval_milliseconds": 2000
        }
      },
      "fields": [
        {
          "id": "fld_store_application_organization_id",
