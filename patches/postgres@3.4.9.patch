diff --git a/cf/src/connection.js b/cf/src/connection.js
index 8e79170aeb13efe8c3c77ccede0cd3a115b5e1b5..4d089e934e7cf036a795df6e0beea53cd5122c8d 100644
--- a/cf/src/connection.js
+++ b/cf/src/connection.js
@@ -254,6 +254,14 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
   }

   function nextWrite(fn) {
+    // A transaction rollback can be queued after closed() cleared the socket.
+    // Reject its queries through the connection error path rather than dropping the write.
+    if (socket === null) {
+      nextWriteTimer !== null && clearImmediate(nextWriteTimer)
+      chunk = nextWriteTimer = null
+      error(errorResponse || Errors.connection('CONNECTION_CLOSED', options, socket))
+      return false
+    }
     const x = socket.write(chunk, fn)
     nextWriteTimer !== null && clearImmediate(nextWriteTimer)
     chunk = nextWriteTimer = null
@@ -367,6 +375,9 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
   function connected() {
     try {
       statements = {}
+      // A new backend must not inherit a terminated backend's pending response or result.
+      query = results = errorResponse = null
+      result = new Result()
       needsTypes = options.fetch_types
       statementId = Math.random().toString(36).slice(2)
       statementCount = 1
@@ -427,6 +438,7 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
       error(Errors.connection('CONNECTION_DESTROYED', options))

     clearImmediate(nextWriteTimer)
+    chunk = nextWriteTimer = null
     if (socket) {
       socket.removeListener('data', data)
       socket.removeListener('connect', connected)
@@ -440,6 +452,7 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     remaining = 0
     incomings = null
     clearImmediate(nextWriteTimer)
+    chunk = nextWriteTimer = null
     socket.removeListener('data', data)
     socket.removeListener('connect', connected)
     idleTimer.cancel()
@@ -452,11 +465,13 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     if (initial)
       return reconnect()

-    !hadError && (query || sent.length) && error(Errors.connection('CONNECTION_CLOSED', options, socket))
+    // A fatal server response has no ReadyForQuery; retain its cause for the caller.
+    const closeError = errorResponse || Errors.connection('CONNECTION_CLOSED', options, socket)
+    !hadError && (query || sent.length) && error(closeError)
     closedTime = performance.now()
     hadError && options.shared.retries++
     delay = (typeof backoff === 'function' ? backoff(options.shared.retries) : backoff) * 1000
-    onclose(connection, Errors.connection('CONNECTION_CLOSED', options, socket))
+    onclose(connection, closeError)
   }

   /* Handlers */
