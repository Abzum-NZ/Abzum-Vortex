select vortex_record.change_record_legal_hold_internal(
  'apply', :'rph_hold_released', :'rph_shared_storage', :'rph_shared_type', :'rph_released',
  null, 'Investigation preservation', pg_catalog.statement_timestamp() + interval '30 days'
);
select vortex_record.change_record_legal_hold_internal(
  'release', :'rph_hold_released', :'rph_shared_storage', :'rph_shared_type', :'rph_released',
  1, 'Investigation closed', null
);
reset role;
