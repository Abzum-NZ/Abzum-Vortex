    null, 'soft_deleted', 2, pg_catalog.statement_timestamp() - interval '20 days',
    pg_catalog.statement_timestamp() - interval '1 day', null),
  (:'rph_org', :'rph_shared_type', :'rph_shared_storage', :'rph_expired',
    null, 'soft_deleted', 2, pg_catalog.statement_timestamp() - interval '40 days',
    pg_catalog.statement_timestamp() - interval '20 days', null),
  (:'rph_org', :'rph_shared_type', :'rph_shared_storage', :'rph_pending',
    null, 'removal_pending', 2, pg_catalog.statement_timestamp() - interval '40 days',
    pg_catalog.statement_timestamp() - interval '20 days', null),
  (:'rph_org', :'rph_shared_type', :'rph_shared_storage', :'rph_held',
    null, 'removal_pending', 2, pg_catalog.statement_timestamp() - interval '40 days',
    pg_catalog.statement_timestamp() - interval '20 days', null),
  (:'rph_org', :'rph_shared_type', :'rph_shared_storage', :'rph_released',
    null, 'removal_pending', 2, pg_catalog.statement_timestamp() - interval '40 days',
    pg_catalog.statement_timestamp() - interval '20 days', null),
  (:'rph_org', :'rph_shared_type', :'rph_shared_storage', :'rph_missing',
