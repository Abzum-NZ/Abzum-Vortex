    pg_catalog.statement_timestamp() - interval '1 day', null);
select vortex_record.record_current_recovery_policy_internal(
  :'rph_shared_storage', :'rph_shared_type', :'rph_policy_shared', 1, 14
);
select vortex_record.record_recovery_provenance_internal(
  :'rph_shared_storage', :'rph_shared_type', record_id, 2
)
from (values
  (:'rph_recoverable'::uuid), (:'rph_expired'::uuid), (:'rph_pending'::uuid),
  (:'rph_held'::uuid), (:'rph_released'::uuid)
) as fixture(record_id);
reset role;

