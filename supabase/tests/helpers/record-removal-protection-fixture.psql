create function pg_temp.rph_context(
  p_organization_id uuid, p_application_root_id uuid,
  p_account_id uuid, p_human boolean
)
returns void language plpgsql volatile set search_path = '' as $function$
declare
  context_value jsonb;
begin
  delete from vortex_context.request_contexts
  where backend_pid = pg_catalog.pg_backend_pid();
  select pg_catalog.jsonb_build_object(
    'callerKind', case when p_human then 'human' else 'system' end,
    'tenantId', organization.tenant_id, 'organizationId', p_organization_id,
    'sessionId', 'a4780000-0000-4000-8000-000000000046'::uuid,
    'authenticationStrength', case when p_human then 'single_factor' else 'service' end,
    'issuedAt', pg_catalog.clock_timestamp() - interval '1 minute',
    'expiresAt', pg_catalog.clock_timestamp() + interval '2 hours',
    'accessVersion', version.current_version,
    'correlationId', 'a4780000-0000-4000-8000-000000000047'::uuid
  ) || case when p_application_root_id is null then '{}'::jsonb
    else pg_catalog.jsonb_build_object('applicationRootId', p_application_root_id) end
    || case when p_human then pg_catalog.jsonb_build_object(
      'identityAuthorityId', 'a4780000-0000-4000-8000-000000000005'::uuid,
      'organizationAccountId', account.organization_account_id,
      'identityId', account.identity_id,
      'accessTokenIssuedAt', pg_catalog.clock_timestamp() - interval '1 minute',
      'primaryAuthenticatedAt', pg_catalog.clock_timestamp() - interval '1 minute'
    ) else pg_catalog.jsonb_build_object(
      'systemActorId', 'a4780000-0000-4000-8000-000000000005'::uuid
    ) end
  into strict context_value
  from vortex_identity.organizations as organization
  join vortex_access.organization_access_versions as version
    on version.organization_id = organization.organization_id
  left join vortex_identity.organization_accounts as account
    on account.organization_id = organization.organization_id
    and account.organization_account_id = p_account_id
  where organization.organization_id = p_organization_id
    and (not p_human or account.organization_account_id is not null);
  perform vortex_context.initialize(context_value);
end
$function$;

select pg_temp.rph_context(:'rph_org', null, :'rph_account', true);
