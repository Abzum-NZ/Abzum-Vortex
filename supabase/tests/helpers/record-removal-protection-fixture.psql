set local role vortex_record_owner;
create table record_data.rt_a478000000004000800000000000000b (
  organisation_id uuid not null,
  record_type_id uuid not null,
  storage_contract_id uuid not null,
  record_id uuid not null,
  application_root_id uuid,
  lifecycle_state text not null,
  concurrency_number bigint not null,
  created_at timestamptz not null,
  deleted_at timestamptz,
  removal_due_at timestamptz,
  primary key (organisation_id, record_id)
);
create table record_data.rt_a478000000004000800000000000000c (
  organisation_id uuid not null,
  record_type_id uuid not null,
  storage_contract_id uuid not null,
  record_id uuid not null,
  application_root_id uuid not null,
  lifecycle_state text not null,
  concurrency_number bigint not null,
  created_at timestamptz not null,
  deleted_at timestamptz,
  removal_due_at timestamptz,
  primary key (organisation_id, application_root_id, record_id)
);
alter table record_data.rt_a478000000004000800000000000000b enable row level security;
alter table record_data.rt_a478000000004000800000000000000b force row level security;
alter table record_data.rt_a478000000004000800000000000000c enable row level security;
alter table record_data.rt_a478000000004000800000000000000c force row level security;
create policy record_scope on record_data.rt_a478000000004000800000000000000b
  for all to vortex_record_adapter
  using (organisation_id = vortex_context.organization_id())
  with check (organisation_id = vortex_context.organization_id());
create policy record_scope on record_data.rt_a478000000004000800000000000000c
  for all to vortex_record_adapter
  using (
    organisation_id = vortex_context.organization_id()
    and application_root_id = vortex_context.application_root_id(true)
  )
  with check (
    organisation_id = vortex_context.organization_id()
    and application_root_id = vortex_context.application_root_id(true)
  );
grant select, insert, update, delete
  on record_data.rt_a478000000004000800000000000000b,
    record_data.rt_a478000000004000800000000000000c
  to vortex_record_adapter;
reset role;

create function pg_temp.rph_context(p_application_root_id uuid, p_human boolean)
returns void language plpgsql volatile set search_path = '' as $function$
declare
  context_value jsonb;
begin
  delete from vortex_context.request_contexts
  where backend_pid = pg_catalog.pg_backend_pid();
  context_value := pg_catalog.jsonb_build_object(
    'callerKind', case when p_human then 'human' else 'system' end,
    'tenantId', 'a4780000-0000-4000-8000-000000000001'::uuid,
    'organizationId', 'a4780000-0000-4000-8000-000000000002'::uuid,
    'sessionId', 'a4780000-0000-4000-8000-000000000040'::uuid,
    'authenticationStrength', case when p_human then 'single_factor' else 'service' end,
    'issuedAt', pg_catalog.clock_timestamp() - interval '1 minute',
    'expiresAt', pg_catalog.clock_timestamp() + interval '1 hour',
    'accessVersion', 1,
    'correlationId', 'a4780000-0000-4000-8000-000000000041'::uuid
  ) || case when p_application_root_id is null then '{}'::jsonb
    else pg_catalog.jsonb_build_object('applicationRootId', p_application_root_id) end;
  if p_human then
    context_value := context_value || pg_catalog.jsonb_build_object(
      'identityAuthorityId', 'a4780000-0000-4000-8000-000000000005'::uuid,
      'organizationAccountId', 'a4780000-0000-4000-8000-000000000004'::uuid,
      'identityId', 'a4780000-0000-4000-8000-000000000003'::uuid,
      'accessTokenIssuedAt', pg_catalog.clock_timestamp() - interval '1 minute',
      'primaryAuthenticatedAt', pg_catalog.clock_timestamp() - interval '1 minute'
    );
  else
    context_value := context_value || pg_catalog.jsonb_build_object(
      'systemActorId', 'a4780000-0000-4000-8000-000000000005'::uuid
    );
  end if;
  perform vortex_context.initialize(context_value);
end
$function$;

select pg_temp.rph_context(null, false);
set local role vortex_record_adapter;
insert into record_data.rt_a478000000004000800000000000000b (
