-- These two source rows are reachable only through deliberately malformed
-- adversarial edges added by 487.  The actual reader must never reach either
-- row under this installation's organisation/application context.  Disable
-- row security only for this fixture seed; the enclosing test rolls the table
-- setting and rows back before any later test can observe them.
set local role vortex_record_owner;
alter table record_data.rt_b4870000000040008000000000000002 disable row level security;
