          'f4950000-0000-4000-8000-000000000053'::uuid]),
      pg_temp.delete_permission('c4950000-0000-4000-8000-000000000053'::uuid,
        'delete.subline.delete', 'd4950000-0000-4000-8000-000000000006'::uuid, 'delete',
        array['f4950000-0000-4000-8000-000000000051'::uuid]),
      pg_temp.delete_permission('c4950000-0000-4000-8000-000000000054'::uuid,
        'delete.subline.restore', 'd4950000-0000-4000-8000-000000000006'::uuid, 'restore',
        array['f4950000-0000-4000-8000-000000000051'::uuid])
