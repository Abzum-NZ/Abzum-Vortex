      pg_temp.delete_permission('c4950000-0000-4000-8000-000000000003'::uuid,
        'delete.parent.delete', 'd4950000-0000-4000-8000-000000000001'::uuid, 'delete',
        array['f4950000-0000-4000-8000-000000000001'::uuid]),
      pg_temp.delete_permission('c4950000-0000-4000-8000-000000000004'::uuid,
        'delete.parent.restore', 'd4950000-0000-4000-8000-000000000001'::uuid, 'restore',
        array['f4950000-0000-4000-8000-000000000001'::uuid]),
      pg_temp.delete_permission('c4950000-0000-4000-8000-000000000011'::uuid,
        'delete.guard.read', 'd4950000-0000-4000-8000-000000000002'::uuid, 'read',
        array['f4950000-0000-4000-8000-000000000011'::uuid,
          'f4950000-0000-4000-8000-000000000012'::uuid]),
      pg_temp.delete_permission('c4950000-0000-4000-8000-000000000021'::uuid,
        'delete.note.read', 'd4950000-0000-4000-8000-000000000003'::uuid, 'read',
        array['f4950000-0000-4000-8000-000000000021'::uuid,
          'f4950000-0000-4000-8000-000000000022'::uuid]),
      pg_temp.delete_permission('c4950000-0000-4000-8000-000000000022'::uuid,
        'delete.note.update', 'd4950000-0000-4000-8000-000000000003'::uuid, 'update',
        array['f4950000-0000-4000-8000-000000000021'::uuid,
          'f4950000-0000-4000-8000-000000000022'::uuid]),
      pg_temp.delete_permission('c4950000-0000-4000-8000-000000000031'::uuid,
        'delete.category.read', 'd4950000-0000-4000-8000-000000000004'::uuid, 'read',
        array['f4950000-0000-4000-8000-000000000031'::uuid,
          'f4950000-0000-4000-8000-000000000032'::uuid,
          'f4950000-0000-4000-8000-000000000033'::uuid,
          'f4950000-0000-4000-8000-000000000034'::uuid]),
      pg_temp.delete_permission('c4950000-0000-4000-8000-000000000032'::uuid,
        'delete.category.update', 'd4950000-0000-4000-8000-000000000004'::uuid, 'update',
        array['f4950000-0000-4000-8000-000000000031'::uuid]),
      pg_temp.delete_permission('c4950000-0000-4000-8000-000000000041'::uuid,
        'delete.line.read', 'd4950000-0000-4000-8000-000000000005'::uuid, 'read',
        array['f4950000-0000-4000-8000-000000000041'::uuid,
          'f4950000-0000-4000-8000-000000000042'::uuid,
          'f4950000-0000-4000-8000-000000000043'::uuid]),
      pg_temp.delete_permission('c4950000-0000-4000-8000-000000000042'::uuid,
        'delete.line.update', 'd4950000-0000-4000-8000-000000000005'::uuid, 'update',
        array['f4950000-0000-4000-8000-000000000041'::uuid,
          'f4950000-0000-4000-8000-000000000042'::uuid,
          'f4950000-0000-4000-8000-000000000043'::uuid]),
      pg_temp.delete_permission('c4950000-0000-4000-8000-000000000043'::uuid,
        'delete.line.delete', 'd4950000-0000-4000-8000-000000000005'::uuid, 'delete',
        array['f4950000-0000-4000-8000-000000000041'::uuid]),
      pg_temp.delete_permission('c4950000-0000-4000-8000-000000000044'::uuid,
        'delete.line.restore', 'd4950000-0000-4000-8000-000000000005'::uuid, 'restore',
        array['f4950000-0000-4000-8000-000000000041'::uuid]),
      -- The same declared delete action, reachable only through ownership. An
