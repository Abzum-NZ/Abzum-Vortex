          pg_temp.delete_relationship('a4950000-0000-4000-8000-000000000003'::uuid,
            'line_parent', 'd4950000-0000-4000-8000-000000000005'::uuid,
            'f4950000-0000-4000-8000-000000000042'::uuid,
            'd4950000-0000-4000-8000-000000000001'::uuid, 'soft_delete_dependent'),
          pg_temp.delete_relationship('a4950000-0000-4000-8000-000000000004'::uuid,
            'line_category', 'd4950000-0000-4000-8000-000000000005'::uuid,
            'f4950000-0000-4000-8000-000000000043'::uuid,
            'd4950000-0000-4000-8000-000000000004'::uuid, 'empty_optional')
        ),
        'standardActions', pg_catalog.jsonb_build_array('read', 'update', 'delete', 'restore'),
        'customActionIds', '[]'::jsonb
