      -- L: the published `soft_delete_dependent` policy, with inherited
      -- ownership declared through that same relationship.
      pg_catalog.jsonb_build_object(
        'recordTypeId', 'd4950000-0000-4000-8000-000000000005'::uuid, 'key', 'line',
        'singularLabel', 'Line', 'pluralLabel', 'Lines',
        'titleFieldId', 'f4950000-0000-4000-8000-000000000041'::uuid,
        'storageContractId', 'b4950000-0000-4000-8000-000000000005'::uuid,
        'storageScope', 'application_contained', 'ownershipMode', 'inherited',
        'ownershipRelationshipId', 'a4950000-0000-4000-8000-000000000003'::uuid,
        'fields', pg_catalog.jsonb_build_array(
          pg_temp.delete_field('f4950000-0000-4000-8000-000000000041'::uuid, 'decimal_number',
