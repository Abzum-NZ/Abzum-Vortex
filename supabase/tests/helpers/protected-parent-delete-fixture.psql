        'storageContractId', 'b4950000-0000-4000-8000-000000000006'::uuid,
        'storageScope', 'application_contained', 'ownershipMode', 'inherited',
        'ownershipRelationshipId', 'a4950000-0000-4000-8000-000000000005'::uuid,
        'fields', pg_catalog.jsonb_build_array(
          pg_temp.delete_field('f4950000-0000-4000-8000-000000000051'::uuid, 'decimal_number',
            '{"digitsBeforeDecimal":10,"decimalPlaces":2}'::jsonb, true),
          pg_temp.delete_field('f4950000-0000-4000-8000-000000000052'::uuid, 'link',
            pg_temp.delete_link('d4950000-0000-4000-8000-000000000005'::uuid,
              'soft_delete_dependent'), true),
          pg_temp.delete_field('f4950000-0000-4000-8000-000000000053'::uuid, 'link',
            pg_temp.delete_link('d4950000-0000-4000-8000-000000000004'::uuid, 'empty_optional'))
        ),
        'relationships', pg_catalog.jsonb_build_array(
          pg_temp.delete_relationship('a4950000-0000-4000-8000-000000000005'::uuid,
            'subline_line', 'd4950000-0000-4000-8000-000000000006'::uuid,
            'f4950000-0000-4000-8000-000000000052'::uuid,
            'd4950000-0000-4000-8000-000000000005'::uuid, 'soft_delete_dependent'),
          pg_temp.delete_relationship('a4950000-0000-4000-8000-000000000006'::uuid,
            'subline_category', 'd4950000-0000-4000-8000-000000000006'::uuid,
            'f4950000-0000-4000-8000-000000000053'::uuid,
            'd4950000-0000-4000-8000-000000000004'::uuid, 'empty_optional')
        ),
        'standardActions', pg_catalog.jsonb_build_array('read', 'update', 'delete', 'restore'),
        'customActionIds', '[]'::jsonb
      )
    ),
    'permissions', pg_catalog.jsonb_build_array(
      pg_temp.delete_permission('c4950000-0000-4000-8000-000000000001'::uuid,
