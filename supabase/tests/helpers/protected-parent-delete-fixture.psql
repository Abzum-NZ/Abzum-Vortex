      -- S: the nested dependant, inherited through its own relationship to L.
      pg_catalog.jsonb_build_object(
        'recordTypeId', 'd4950000-0000-4000-8000-000000000006'::uuid, 'key', 'subline',
        'singularLabel', 'Subline', 'pluralLabel', 'Sublines',
