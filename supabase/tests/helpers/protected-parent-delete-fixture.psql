-- Included only by 489_protected_parent_deletion.test.sql.  It creates the
-- smallest real installed application that carries all three published
-- onParentDelete policies together with concrete relationship totals, which is
-- what #49 composes.  Definition publishing, permission registration, role
-- assignment, storage provisioning and activation all use their owning
-- writers; every Record under test is created through the owning create
-- primitive, and the pre-delete generated values are written through the owning
-- generated-value writer.  Only fixture identifiers, the tenant, the
-- organisation and the first administrator account are inserted directly,
-- because no provisioning writer exists for them (#30).
--
-- Shape.
--   parent      P  -- the named delete subject; no generated values of its own
--   guard       G  -- refuse            -> P   (blocks P1's deletion)
--   note        N  -- empty_optional    -> P   (cleared when P2 is deleted)
--   line        L  -- soft_delete_dependent -> P, inherited ownership through
--                     that same relationship, and empty_optional -> C
--   subline     S  -- soft_delete_dependent -> L, inherited ownership through
--                     that same relationship, and empty_optional -> C
--   category    C  -- the SURVIVING total-bearing parent of L and S
--
-- Deleting P2 therefore cascades L and its nested dependant S, clears N's
-- optional link, and must leave C's two totals and its dependent calculation
-- authoritative.  Deleting P1 must refuse because G declares `refuse`.

\set tenant '14950000-0000-4000-8000-000000000001'
\set org '24950000-0000-4000-8000-000000000001'
\set actor '94950000-0000-4000-8000-000000000001'
\set admin_identity '54950000-0000-4000-8000-000000000001'
\set admin_account '64950000-0000-4000-8000-000000000001'
\set module '44950000-0000-4000-8000-000000000001'
\set app '34950000-0000-4000-8000-000000000001'

\set parent_type 'd4950000-0000-4000-8000-000000000001'
\set guard_type 'd4950000-0000-4000-8000-000000000002'
\set note_type 'd4950000-0000-4000-8000-000000000003'
\set category_type 'd4950000-0000-4000-8000-000000000004'
\set line_type 'd4950000-0000-4000-8000-000000000005'
\set subline_type 'd4950000-0000-4000-8000-000000000006'

\set parent_storage 'b4950000-0000-4000-8000-000000000001'
\set guard_storage 'b4950000-0000-4000-8000-000000000002'
\set note_storage 'b4950000-0000-4000-8000-000000000003'
\set category_storage 'b4950000-0000-4000-8000-000000000004'
\set line_storage 'b4950000-0000-4000-8000-000000000005'
\set subline_storage 'b4950000-0000-4000-8000-000000000006'

\set rel_guard_parent 'a4950000-0000-4000-8000-000000000001'
\set rel_note_parent 'a4950000-0000-4000-8000-000000000002'
\set rel_line_parent 'a4950000-0000-4000-8000-000000000003'
\set rel_line_category 'a4950000-0000-4000-8000-000000000004'
\set rel_subline_line 'a4950000-0000-4000-8000-000000000005'
\set rel_subline_category 'a4950000-0000-4000-8000-000000000006'

\set f_parent_title 'f4950000-0000-4000-8000-000000000001'
\set f_guard_title 'f4950000-0000-4000-8000-000000000011'
\set f_guard_parent 'f4950000-0000-4000-8000-000000000012'
\set f_note_title 'f4950000-0000-4000-8000-000000000021'
\set f_note_parent 'f4950000-0000-4000-8000-000000000022'
\set f_category_title 'f4950000-0000-4000-8000-000000000031'
\set f_category_line_total 'f4950000-0000-4000-8000-000000000032'
\set f_category_display 'f4950000-0000-4000-8000-000000000033'
\set f_category_subline_total 'f4950000-0000-4000-8000-000000000034'
\set f_line_amount 'f4950000-0000-4000-8000-000000000041'
\set f_line_parent 'f4950000-0000-4000-8000-000000000042'
\set f_line_category 'f4950000-0000-4000-8000-000000000043'
\set f_subline_amount 'f4950000-0000-4000-8000-000000000051'
\set f_subline_line 'f4950000-0000-4000-8000-000000000052'
\set f_subline_category 'f4950000-0000-4000-8000-000000000053'

\set p_parent_read 'c4950000-0000-4000-8000-000000000001'
\set p_parent_update 'c4950000-0000-4000-8000-000000000002'
\set p_parent_delete 'c4950000-0000-4000-8000-000000000003'
\set p_parent_restore 'c4950000-0000-4000-8000-000000000004'
\set p_guard_read 'c4950000-0000-4000-8000-000000000011'
\set p_note_read 'c4950000-0000-4000-8000-000000000021'
\set p_note_update 'c4950000-0000-4000-8000-000000000022'
\set p_category_read 'c4950000-0000-4000-8000-000000000031'
\set p_category_update 'c4950000-0000-4000-8000-000000000032'
\set p_line_read 'c4950000-0000-4000-8000-000000000041'
\set p_line_update 'c4950000-0000-4000-8000-000000000042'
\set p_line_delete 'c4950000-0000-4000-8000-000000000043'
\set p_line_restore 'c4950000-0000-4000-8000-000000000044'
\set p_line_delete_owned 'c4950000-0000-4000-8000-000000000045'
\set p_subline_read 'c4950000-0000-4000-8000-000000000051'
\set p_subline_update 'c4950000-0000-4000-8000-000000000052'
\set p_subline_delete 'c4950000-0000-4000-8000-000000000053'
\set p_subline_restore 'c4950000-0000-4000-8000-000000000054'

\set parent_table 'rt_b4950000000040008000000000000001'
\set guard_table 'rt_b4950000000040008000000000000002'
\set note_table 'rt_b4950000000040008000000000000003'
\set category_table 'rt_b4950000000040008000000000000004'
\set line_table 'rt_b4950000000040008000000000000005'
\set subline_table 'rt_b4950000000040008000000000000006'

create function pg_temp.delete_sha(p_value text)
returns text language sql immutable set search_path = '' as $function$
  select 'sha256:' || pg_catalog.encode(pg_catalog.sha256(pg_catalog.convert_to(p_value, 'UTF8')), 'hex')
$function$;

create function pg_temp.delete_field(
  p_field_id uuid, p_type text, p_settings jsonb default '{}'::jsonb,
  p_required boolean default false
)
returns jsonb language sql immutable set search_path = '' as $function$
  select pg_catalog.jsonb_build_object(
    'fieldId', p_field_id, 'key', 'f_' || pg_catalog.replace(p_field_id::text, '-', ''),
    'type', p_type, 'required', p_required, 'unique', false, 'filterable', false,
    'sortable', false, 'settings', p_settings)
$function$;

create function pg_temp.delete_link(p_target_type uuid, p_on_parent_delete text)
returns jsonb language sql immutable set search_path = '' as $function$
  select pg_catalog.jsonb_build_object(
    'target', pg_catalog.jsonb_build_object('state', 'resolved',
      'moduleRootId', '44950000-0000-4000-8000-000000000001'::uuid,
      'recordTypeId', p_target_type),
    'onParentDelete', p_on_parent_delete)
$function$;

create function pg_temp.delete_relationship(
  p_relationship_id uuid, p_key text, p_from_type uuid, p_from_field uuid,
  p_to_type uuid, p_on_parent_delete text
)
returns jsonb language sql immutable set search_path = '' as $function$
  select pg_catalog.jsonb_build_object(
    'relationshipId', p_relationship_id, 'key', p_key,
    'fromRecordTypeId', p_from_type, 'fromFieldId', p_from_field,
    'toRecordType', pg_catalog.jsonb_build_object('state', 'resolved',
      'moduleRootId', '44950000-0000-4000-8000-000000000001'::uuid,
      'recordTypeId', p_to_type),
    'cardinality', 'many_to_one', 'onParentDelete', p_on_parent_delete)
$function$;

create function pg_temp.delete_permission(
  p_permission_id uuid, p_key text, p_record_type_id uuid, p_action_kind text,
  p_fields uuid[], p_routes jsonb default '[{"kind":"all_records"}]'::jsonb
)
returns jsonb language sql immutable set search_path = '' as $function$
  select pg_catalog.jsonb_build_object(
    'permissionId', p_permission_id, 'key', p_key, 'label', p_key,
    'description', 'Protected parent delete fixture permission.',
    'recordTypeId', p_record_type_id,
    'recordScope', pg_catalog.jsonb_build_object('routes', p_routes),
    'fieldPolicy', pg_catalog.jsonb_build_object(
      'readableFieldIds', pg_catalog.to_jsonb(p_fields),
      'changeableFieldIds', case when p_action_kind in ('update', 'create')
        then pg_catalog.to_jsonb(p_fields) else '[]'::jsonb end),
    'actionKind', p_action_kind, 'administrative', false)
$function$;

create function pg_temp.delete_module_content()
returns jsonb language sql stable set search_path = '' as $function$
  select pg_catalog.jsonb_build_object(
    'name', 'Protected parent delete fixture',
    'description', 'Installed parent, guard, note, category, line and subline records.',
    'dependencies', '[]'::jsonb,
    'recordTypes', pg_catalog.jsonb_build_array(
      -- P: the delete subject. It declares no generated value of its own, so
      -- every authoritative value this command must preserve belongs to a
      -- surviving affected record.
      pg_catalog.jsonb_build_object(
        'recordTypeId', 'd4950000-0000-4000-8000-000000000001'::uuid, 'key', 'parent',
        'singularLabel', 'Parent', 'pluralLabel', 'Parents',
        'titleFieldId', 'f4950000-0000-4000-8000-000000000001'::uuid,
        'storageContractId', 'b4950000-0000-4000-8000-000000000001'::uuid,
        'storageScope', 'application_contained', 'ownershipMode', 'organization_account',
        'fields', pg_catalog.jsonb_build_array(
          pg_temp.delete_field('f4950000-0000-4000-8000-000000000001'::uuid, 'text',
            '{"maxLength":200}'::jsonb, true)
        ),
        'relationships', '[]'::jsonb,
        'standardActions', pg_catalog.jsonb_build_array('read', 'update', 'delete', 'restore'),
        'customActionIds', '[]'::jsonb
      ),
      -- G: the published `refuse` policy.
      pg_catalog.jsonb_build_object(
        'recordTypeId', 'd4950000-0000-4000-8000-000000000002'::uuid, 'key', 'guard',
        'singularLabel', 'Guard', 'pluralLabel', 'Guards',
        'titleFieldId', 'f4950000-0000-4000-8000-000000000011'::uuid,
        'storageContractId', 'b4950000-0000-4000-8000-000000000002'::uuid,
        'storageScope', 'application_contained', 'ownershipMode', 'organization_account',
        'fields', pg_catalog.jsonb_build_array(
          pg_temp.delete_field('f4950000-0000-4000-8000-000000000011'::uuid, 'text',
            '{"maxLength":200}'::jsonb, true),
          pg_temp.delete_field('f4950000-0000-4000-8000-000000000012'::uuid, 'link',
            pg_temp.delete_link('d4950000-0000-4000-8000-000000000001'::uuid, 'refuse'), true)
        ),
        'relationships', pg_catalog.jsonb_build_array(
          pg_temp.delete_relationship('a4950000-0000-4000-8000-000000000001'::uuid,
            'guard_parent', 'd4950000-0000-4000-8000-000000000002'::uuid,
            'f4950000-0000-4000-8000-000000000012'::uuid,
            'd4950000-0000-4000-8000-000000000001'::uuid, 'refuse')
        ),
        'standardActions', pg_catalog.jsonb_build_array('read', 'update'),
        'customActionIds', '[]'::jsonb
      ),
      -- N: the published `empty_optional` policy on a surviving child.
      pg_catalog.jsonb_build_object(
        'recordTypeId', 'd4950000-0000-4000-8000-000000000003'::uuid, 'key', 'note',
        'singularLabel', 'Note', 'pluralLabel', 'Notes',
        'titleFieldId', 'f4950000-0000-4000-8000-000000000021'::uuid,
        'storageContractId', 'b4950000-0000-4000-8000-000000000003'::uuid,
        'storageScope', 'application_contained', 'ownershipMode', 'organization_account',
        'fields', pg_catalog.jsonb_build_array(
          pg_temp.delete_field('f4950000-0000-4000-8000-000000000021'::uuid, 'text',
            '{"maxLength":200}'::jsonb, true),
          pg_temp.delete_field('f4950000-0000-4000-8000-000000000022'::uuid, 'link',
            pg_temp.delete_link('d4950000-0000-4000-8000-000000000001'::uuid, 'empty_optional'))
        ),
        'relationships', pg_catalog.jsonb_build_array(
          pg_temp.delete_relationship('a4950000-0000-4000-8000-000000000002'::uuid,
            'note_parent', 'd4950000-0000-4000-8000-000000000003'::uuid,
            'f4950000-0000-4000-8000-000000000022'::uuid,
            'd4950000-0000-4000-8000-000000000001'::uuid, 'empty_optional')
        ),
        'standardActions', pg_catalog.jsonb_build_array('read', 'update'),
        'customActionIds', '[]'::jsonb
      ),
      -- C: the surviving total-bearing parent of both cascade-deleted types.
      pg_catalog.jsonb_build_object(
        'recordTypeId', 'd4950000-0000-4000-8000-000000000004'::uuid, 'key', 'category',
        'singularLabel', 'Category', 'pluralLabel', 'Categories',
        'titleFieldId', 'f4950000-0000-4000-8000-000000000031'::uuid,
        'storageContractId', 'b4950000-0000-4000-8000-000000000004'::uuid,
        'storageScope', 'application_contained', 'ownershipMode', 'organization_account',
        'fields', pg_catalog.jsonb_build_array(
          pg_temp.delete_field('f4950000-0000-4000-8000-000000000031'::uuid, 'text',
            '{"maxLength":200}'::jsonb, true),
          pg_temp.delete_field('f4950000-0000-4000-8000-000000000032'::uuid, 'total',
            pg_catalog.jsonb_build_object(
              'relationshipId', 'a4950000-0000-4000-8000-000000000004'::uuid,
              'operation', 'sum', 'resultType', 'decimal_number',
              'fieldId', 'f4950000-0000-4000-8000-000000000041'::uuid)),
          pg_temp.delete_field('f4950000-0000-4000-8000-000000000033'::uuid, 'calculation',
            pg_catalog.jsonb_build_object('resultType', 'decimal_number',
              'dependencyFieldIds', pg_catalog.jsonb_build_array(
                'f4950000-0000-4000-8000-000000000032'::uuid,
                'f4950000-0000-4000-8000-000000000034'::uuid))),
          pg_temp.delete_field('f4950000-0000-4000-8000-000000000034'::uuid, 'total',
            pg_catalog.jsonb_build_object(
              'relationshipId', 'a4950000-0000-4000-8000-000000000006'::uuid,
              'operation', 'sum', 'resultType', 'decimal_number',
              'fieldId', 'f4950000-0000-4000-8000-000000000051'::uuid))
        ),
        'relationships', '[]'::jsonb,
        'standardActions', pg_catalog.jsonb_build_array('read', 'update'),
        'customActionIds', '[]'::jsonb
