{
  "email_1_0_0": {
    "rootId": "6d1f0c52-3b7a-4c4e-8a51-0e1a7b0c9d16",
    "releaseVersion": "1.0.0",
    "source": {
      "source_contract_version": "1.0.0",
      "kind": "connection_type",
      "root_alias": "connection_email",
      "key": "vortex.connection.email",
      "body": {
        "name": "Email",
        "purpose": "Provider-neutral email connection contract for CRM and Service Desk. No provider adapter is supported yet, and the reserved host prevents remote calls until a later adapter-backed release is published.",
        "provider": "Provider-neutral; no provider adapter supported",
        "authentication": {
          "kind": "oauth2",
          "secret_fields": ["client_id", "client_secret", "refresh_token"],
          "scopes": ["messages.send", "delivery.read"]
        },
        "allowed_hosts": ["email.adapter-unavailable.invalid"],
        "allow_redirects": false,
        "shapes": [
          {
            "key": "email_message",
            "fields": [
              { "key": "recipient", "type": "text", "required": true },
              { "key": "subject", "type": "text", "required": true },
              { "key": "body", "type": "text", "required": true }
            ]
          },
          {
            "key": "template_message",
            "fields": [
              { "key": "recipient", "type": "text", "required": true },
              { "key": "template_key", "type": "text", "required": true },
              { "key": "variables", "type": "json", "required": true }
            ]
          },
          {
            "key": "delivery_receipt",
            "fields": [
              { "key": "provider_message_id", "type": "text", "required": true },
              { "key": "accepted", "type": "boolean", "required": true }
            ]
          },
          {
            "key": "delivery_status",
            "fields": [
              { "key": "provider_message_id", "type": "text", "required": true },
              { "key": "status", "type": "text", "required": true }
            ]
          },
          { "key": "health_check_request", "fields": [] },
          {
            "key": "health_check_result",
            "fields": [{ "key": "healthy", "type": "boolean", "required": true }]
          }
        ],
        "operations": [
          {
            "key": "send_message",
            "method": "POST",
            "path": "/v1/messages",
            "input": "email_message",
            "output": "delivery_receipt",
            "timeout_seconds": 20,
            "max_attempts": 3,
            "maximum_response_bytes": 1000000
          },
          {
            "key": "send_template",
            "method": "POST",
            "path": "/v1/templates/send",
            "input": "template_message",
            "output": "delivery_receipt",
            "timeout_seconds": 20,
            "max_attempts": 3,
            "maximum_response_bytes": 1000000
          },
          {
            "key": "check_health",
            "method": "GET",
            "path": "/health",
            "input": "health_check_request",
            "output": "health_check_result",
            "timeout_seconds": 10,
            "max_attempts": 1,
            "maximum_response_bytes": 4096
          }
        ],
        "incoming_messages": [
          {
            "key": "delivery_status",
            "signature": "hmac_sha256",
            "replay_window_seconds": 300,
            "input": "delivery_status",
            "workflow_trigger": "delivery_status_received"
          }
        ],
        "health_operation": "check_health"
      }
    }
  },
  "calendar_1_0_0": {
    "rootId": "6d1f0c52-3b7a-4c4e-8a51-0e1a7b0c9d17",
    "releaseVersion": "1.0.0",
    "source": {
      "source_contract_version": "1.0.0",
      "kind": "connection_type",
      "root_alias": "connection_calendar",
      "key": "vortex.connection.calendar",
      "body": {
        "name": "Calendar",
        "purpose": "Provider-neutral calendar connection contract for CRM. No provider adapter is supported yet, and the reserved host prevents remote calls until a later adapter-backed release is published.",
        "provider": "Provider-neutral; no provider adapter supported",
        "authentication": {
          "kind": "oauth2",
          "secret_fields": ["client_id", "client_secret", "refresh_token"],
          "scopes": ["events.write"]
        },
        "allowed_hosts": ["calendar.adapter-unavailable.invalid"],
        "allow_redirects": false,
        "shapes": [
          {
            "key": "calendar_event",
            "fields": [
              { "key": "title", "type": "text", "required": true },
              { "key": "starts_at", "type": "date_time", "required": true },
              { "key": "ends_at", "type": "date_time", "required": true }
            ]
          },
          {
            "key": "calendar_event_reference",
            "fields": [{ "key": "event_id", "type": "text", "required": true }]
          },
          {
            "key": "calendar_event_receipt",
            "fields": [
              { "key": "event_id", "type": "text", "required": true },
              { "key": "accepted", "type": "boolean", "required": true }
            ]
          },
          { "key": "health_check_request", "fields": [] },
          {
            "key": "health_check_result",
            "fields": [{ "key": "healthy", "type": "boolean", "required": true }]
          }
        ],
        "operations": [
          {
            "key": "create_event",
            "method": "POST",
            "path": "/v1/events",
            "input": "calendar_event",
            "output": "calendar_event_receipt",
            "timeout_seconds": 20,
            "max_attempts": 3,
            "maximum_response_bytes": 1000000
          },
          {
            "key": "cancel_event",
            "method": "POST",
            "path": "/v1/events/cancel",
            "input": "calendar_event_reference",
            "output": "calendar_event_receipt",
            "timeout_seconds": 20,
            "max_attempts": 3,
            "maximum_response_bytes": 1000000
          },
          {
            "key": "check_health",
            "method": "GET",
            "path": "/health",
            "input": "health_check_request",
            "output": "health_check_result",
            "timeout_seconds": 10,
            "max_attempts": 1,
            "maximum_response_bytes": 4096
          }
        ],
        "incoming_messages": [],
        "health_operation": "check_health"
      }
    }
  },
  "webhook_1_0_0": {
    "rootId": "6d1f0c52-3b7a-4c4e-8a51-0e1a7b0c9d18",
    "releaseVersion": "1.0.0",
    "source": {
      "source_contract_version": "1.0.0",
      "kind": "connection_type",
      "root_alias": "connection_webhook",
      "key": "vortex.connection.webhook",
      "body": {
        "name": "Webhook",
        "purpose": "Provider-neutral signed JSON connection contract for Service Desk. No provider adapter is supported yet, and the reserved host prevents remote calls until a later adapter-backed release is published.",
        "provider": "Provider-neutral; no provider adapter supported",
        "authentication": {
          "kind": "signed_secret",
          "secret_fields": ["signing_secret"],
          "algorithm": "hmac_sha256"
        },
        "allowed_hosts": ["webhook.adapter-unavailable.invalid"],
        "allow_redirects": false,
        "shapes": [
          {
            "key": "signed_json",
            "fields": [
              { "key": "event_key", "type": "text", "required": true },
              { "key": "payload", "type": "json", "required": true }
            ]
          },
          {
            "key": "webhook_receipt",
            "fields": [{ "key": "accepted", "type": "boolean", "required": true }]
          },
          {
            "key": "external_case",
            "fields": [
              { "key": "external_id", "type": "text", "required": true },
              { "key": "payload", "type": "json", "required": true }
            ]
          },
          { "key": "health_check_request", "fields": [] },
          {
            "key": "health_check_result",
            "fields": [{ "key": "healthy", "type": "boolean", "required": true }]
          }
        ],
        "operations": [
          {
            "key": "post_json",
            "method": "POST",
            "path": "/events",
            "input": "signed_json",
            "output": "webhook_receipt",
            "timeout_seconds": 15,
            "max_attempts": 5,
            "maximum_response_bytes": 1000000
          },
          {
            "key": "check_health",
            "method": "GET",
            "path": "/health",
            "input": "health_check_request",
            "output": "health_check_result",
            "timeout_seconds": 10,
            "max_attempts": 1,
            "maximum_response_bytes": 4096
          }
        ],
        "incoming_messages": [
          {
            "key": "case_created",
            "signature": "hmac_sha256",
            "replay_window_seconds": 300,
            "input": "external_case",
            "workflow_trigger": "external_event_received"
          }
        ],
        "health_operation": "check_health"
      }
    }
  }
}
