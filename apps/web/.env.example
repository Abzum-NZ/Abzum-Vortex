# Server-only configuration for the web application. Copy to .env.local and fill in local values.
# Never prefix a secret with NEXT_PUBLIC_ and never commit a real value.
# `pnpm db:start` prints the local API URL and publishable key.
# See the "Local environment variables" section of the repository README.

# Selects local behaviour. Must be `local` for the local stack and the development setup.
VORTEX_ENVIRONMENT=local

# The configured site URL. Identity-session cookies and auth redirects are built from it.
VORTEX_SITE_URL=http://127.0.0.1:3000

# The local Supabase API and Auth endpoint.
VORTEX_SUPABASE_URL=http://127.0.0.1:54321

# The public key the browser sign-in journey uses. Copy it from `pnpm exec supabase status`.
VORTEX_SUPABASE_PUBLISHABLE_KEY=

# Pins the local identity authority. Use the same value for `pnpm dev` and `pnpm setup:local`.
VORTEX_IDENTITY_AUTHORITY_ID=

# Key that makes Query continuation tokens opaque: base64 of exactly 32 random bytes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VORTEX_QUERY_CONTINUATION_KEY=

# Restricted runtime connection to the local database. Defaults to this address when unset.
VORTEX_RUNTIME_DATABASE_URL=postgresql://vortex_runtime:vortex-runtime-local-only@127.0.0.1:54322/postgres

# Optional runtime connection-pool cap; a local default applies when unset.
# VORTEX_RUNTIME_DATABASE_POOL_SIZE=10

# Trusted root certificate for a hosted runtime connection. Not needed for the local loopback database.
# VORTEX_RUNTIME_DATABASE_SSL_ROOT_CERT=

# Read by the components, files and workflow features; set them when you exercise those pages.
# VORTEX_COMPONENT_BUNDLE_ORIGIN=
# VORTEX_FILE_STORAGE_SIGNING_KEY=
# VORTEX_FILE_STORAGE_SIGNING_KEY_ID=
# VORTEX_APPLICATION_KESTRA_URL=
# VORTEX_WORKFLOW_CALLBACK_KEY=
# VORTEX_CLUSTER_ID=
