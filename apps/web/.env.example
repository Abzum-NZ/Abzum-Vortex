# Server-only configuration for the web application. Copy to .env.local and fill in local values.
# Never prefix a secret with NEXT_PUBLIC_ and never commit a real value.
# `pnpm db:start` prints the local API URL and publishable key.
# See the "Local environment variables" section of the repository README.

# Selects local behaviour. Must be `local` for the local stack and the development setup.
VORTEX_ENVIRONMENT=local

# The configured site URL. Identity-session cookies and auth redirects are built from it.
VORTEX_SITE_URL=http://127.0.0.1:3000

# The local Supabase API and Auth endpoint.
VORTEX_SUPABASE_URL=http://127.0.0.1:54321

# The public key the browser sign-in journey uses. Copy it from `pnpm exec supabase status`.
VORTEX_SUPABASE_PUBLISHABLE_KEY=

# Pins the local identity authority. Export the same value in the shell that runs `pnpm setup:local`.
VORTEX_IDENTITY_AUTHORITY_ID=

# Key that makes Query continuation tokens opaque: base64 of exactly 32 random bytes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VORTEX_QUERY_CONTINUATION_KEY=

# Restricted runtime connection to the local database. Required by `pnpm dev`.
VORTEX_RUNTIME_DATABASE_URL=postgresql://vortex_runtime:vortex-runtime-local-only@127.0.0.1:54322/postgres

# Optional runtime connection-pool cap (1 to 20); 5 applies when unset.
# VORTEX_RUNTIME_DATABASE_POOL_SIZE=5

# Trusted root certificate for a hosted runtime connection. Not needed for the local loopback database.
# VORTEX_RUNTIME_DATABASE_SSL_ROOT_CERT=

# Dedicated origin for the component sandbox. Use a separate host from the Vortex site and its
# parent or child domains; the route refuses overlapping hosts.
# VORTEX_COMPONENT_BUNDLE_ORIGIN=https://components.example.invalid

# Server-only ES256 storage-token signing configuration for component and file routes. The key must
# be a P-256 private key from trusted secret storage; literal \n sequences are accepted for line
# breaks. The key ID is the active identifier included in token headers.
# VORTEX_FILE_STORAGE_SIGNING_KEY=<P-256 private key from trusted secret storage>
# VORTEX_FILE_STORAGE_SIGNING_KEY_ID=<active key ID>

# Platform-operator context for server-side Identity and Access operations. These IDs must identify
# the configured system actor and its cluster; never use a request or human identity. Local setup
# supplies them from its manifest, so they are not needed in a local .env.local.
# VORTEX_CLUSTER_ID=<cluster UUID>
# VORTEX_TENANT_ADMINISTRATION_OPERATOR_ACTOR_ID=<configured system actor UUID>

# Origin of the dedicated application Kestra instance used by Workflow callbacks. Never point this
# at the operations instance. Hosted instances use HTTPS; local development may use HTTP on loopback.
# VORTEX_APPLICATION_KESTRA_URL=https://application-kestra.example.invalid

# Shared callback signing key used by the application Kestra flow secret and the Vortex callback
# verifier. Obtain it from trusted secret storage and configure the same value on both sides.
# VORTEX_WORKFLOW_CALLBACK_KEY=<shared callback signing key>

# Optional SHA-256 digest for the event-dispatcher wake-up bearer credential (lowercase, 64-character
# hex). The Vortex server stores only this digest; keep the raw credential in its protected sources.
# VORTEX_EVENT_DISPATCHER_CREDENTIAL_SHA256=<lowercase SHA-256 hex digest>

# `pnpm setup:local` runs outside Turbo and does not load .env.local. For detailed local setup errors,
# export VORTEX_SETUP_DEBUG=1 in the shell running that command. Keep it disabled elsewhere.
# VORTEX_SETUP_DEBUG=1
